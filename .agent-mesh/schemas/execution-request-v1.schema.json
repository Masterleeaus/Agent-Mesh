{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan-agent-mesh-execution-request/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema","request_id","issue_number","subgoal_id","claim_branch","expected_head_sha","operation"],
  "properties": {
    "schema": {"const": "titan-agent-mesh-execution-request/v1"},
    "request_id": {"type":"string","pattern":"^[A-Za-z0-9._-]{8,120}$"},
    "issue_number": {"type":"integer","minimum":1},
    "subgoal_id": {"type":"string","pattern":"^TZ-(G00|ROADMAP-[0-9]+)-SG-[0-9]+$"},
    "claim_branch": {"type":"string","pattern":"^agent/TZ-(G00|ROADMAP-[0-9]+)-SG-[0-9]+$"},
    "expected_head_sha": {"type":"string","pattern":"^[0-9a-fA-F]{40}$"},
    "operation": {"enum":["verify.agent_mesh_ci","inventory.repository","refresh.roadmap_index","cleanup.empty_directories"]},
    "parameters": {"type":"object","default":{}},
    "authority": {
      "type":"object",
      "properties":{"merge":{"const":false},"release_claim":{"const":false},"ai":{"const":false}},
      "additionalProperties":false
    }
  }
}
