{
  "manifest_version": 3,
  "name": "Titan Zero Browser Node",
  "version": "0.1.0",
  "description": "Governed browser execution node for Titan Zero field-service operations, workforce tasks, evidence capture and verified outcomes.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "sidePanel",
    "clipboardWrite",
    "offscreen",
    "debugger"
  ],
  "host_permissions": [
    "*://chatgpt.com/*",
    "*://claude.ai/*"
  ],
  "side_panel": {
    "default_path": "src/sidebar/sidebar.html"
  },
  "action": {
    "default_title": "Titan Zero Browser Node",
    "default_icon": {
      "16": "public/icons/icon-16.png",
      "32": "public/icons/icon-32.png",
      "48": "public/icons/icon-48.png",
      "128": "public/icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "src/lib/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/browser/webmcp-page-helper.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://chatgpt.com/*",
        "*://claude.ai/*"
      ],
      "js": [
        "src/providers/provider-registry.js",
        "src/content-script.js"
      ],
      "run_at": "document_end"
    }
  ],
  "minimum_chrome_version": "114",
  "icons": {
    "16": "public/icons/icon-16.png",
    "32": "public/icons/icon-32.png",
    "48": "public/icons/icon-48.png",
    "128": "public/icons/icon-128.png"
  },
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "http://localhost:43127/*",
    "http://127.0.0.1:43127/*",
    "https://*/*",
    "http://*/*"
  ]
}
