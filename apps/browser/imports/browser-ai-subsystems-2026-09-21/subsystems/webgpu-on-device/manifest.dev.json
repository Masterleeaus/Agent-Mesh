{
  "manifest_version": 3,
  "name": "Privane Browser Intelligence [DEV]",
  "short_name": "Privane [DEV]",
  "version": "1.1.0",
  "description": "DEV BUILD — A private, on-device AI browser assistant powered by WebGPU and Gemma 2B.",
  "permissions": ["sidePanel", "storage", "offscreen", "tabs", "scripting", "bookmarks", "activeTab", "history"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Open PRIVANE AI Panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["wasm/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
