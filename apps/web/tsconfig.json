{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@ai-fsm/domain": [
        "../../packages/domain/src/index.ts"
      ],
      "@ai-fsm/domain/*": [
        "../../packages/domain/src/*"
      ],
      "@ai-fsm/money": [
        "../../packages/money/src/index.ts"
      ],
      "@ai-fsm/log": [
        "../../packages/log/src/index.ts"
      ],
      "@ai-fsm/titan-platform/*": [
        "../../packages/titan-platform/src/*"
      ]
    },
    "types": [
      "node"
    ],
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.spec.ts",
    "marketing-source/**"
  ]
}
