DirectoryIndex index.html
Options -MultiViews -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?([a-z0-9-]+\.)?titanzero\.io$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^www\.titanzero\.io$ [NC]
  RewriteRule ^ https://titanzero.io%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/cleaning/?$ https://cleaning.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/window-cleaning/?$ https://window-cleaning.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/pressure-washing/?$ https://pressure-washing.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/(pools|pool-service)/?$ https://pool-service.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/pest-control/?$ https://pest-control.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/plumbing/?$ https://plumbing.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/electrical/?$ https://electrical.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/hvac/?$ https://hvac.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/locksmith-security/?$ https://locksmith-security.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/appliance-equipment-repair/?$ https://appliance-equipment-repair.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/construction/?$ https://construction.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/roofing/?$ https://roofing.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/tiling/?$ https://tiling.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/concreting/?$ https://concreting.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/renovations/?$ https://renovations.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/(landscaping|landscaping-lawn-care)/?$ https://landscaping-lawn-care.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/(handyman|property-maintenance|handyman-property-maintenance)/?$ https://handyman-property-maintenance.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/mobile-services/?$ https://mobile-services.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/painting/?$ https://painting.titanzero.io/ [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/plastering/?$ https://plastering.titanzero.io/ [R=301,L,NE]
  RewriteRule ^sitemap\.xml$ - [G,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
