DirectoryIndex index.html
Options -MultiViews -Indexes
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^(www\.)?([a-z0-9-]+\.)?titanzero\.io$ [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^www\.titanzero\.io$ [NC]
  RewriteRule ^ https://titanzero.io%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^(www\.)?titanzero\.io$ [NC]
  RewriteRule ^industries/cleaning/?$ https://cleaning.titanzero.io/ [R=301,L,NE]
  RewriteRule ^sitemap\.xml$ - [G,L]
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]
  RewriteRule ^ index.html [L]
</IfModule>
