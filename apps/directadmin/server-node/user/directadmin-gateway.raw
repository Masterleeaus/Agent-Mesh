#!/bin/sh
set -eu
MODULE_HOME="${TITAN_SERVER_NODE_HOME:-/usr/local/titan/server-node}"
RELAY_MODULE="$MODULE_HOME/directadmin-relay.mjs"
NODE_BIN=/usr/bin/node
if [ "${NODE_ENV:-}" = test ] && [ -n "${TITAN_SERVER_NODE_DIRECTADMIN_RELAY_TEST_NODE_BIN:-}" ]; then
  NODE_BIN=$TITAN_SERVER_NODE_DIRECTADMIN_RELAY_TEST_NODE_BIN
fi
if [ ! -r "$RELAY_MODULE" ]; then
  printf 'HTTP/1.1 503 Service Unavailable\r\n'
  printf 'Content-Type: application/json; charset=utf-8\r\n'
  printf 'Cache-Control: no-store\r\n'
  printf 'X-Content-Type-Options: nosniff\r\n'
  printf 'Content-Length: 49\r\nConnection: close\r\n\r\n'
  printf '{"error":"relay_not_configured","read_only":true}'
  exit 0
fi
exec "$NODE_BIN" "$RELAY_MODULE"
