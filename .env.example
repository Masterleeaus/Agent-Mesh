# App
NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# Canonical local persistence
# SQLite requires no database server or Redis for normal Titan operation.
DATABASE_DIALECT=sqlite
DATABASE_URL=file:./data/titan-zero.db

# Optional server/database compatibility deployments only:
# DATABASE_DIALECT=postgres
# DATABASE_URL=postgresql://ai_fsm:password@localhost:5432/ai_fsm
# DATABASE_DIALECT=mysql
# DATABASE_URL=mysql://ai_fsm:password@localhost:3306/ai_fsm

# Optional distributed coordination. Never required for ordinary local operation.
# REDIS_URL=redis://localhost:6379

# Auth
# REQUIRED: Must be at least 32 characters. Generate with: openssl rand -hex 32
AUTH_SECRET=change_me_to_a_long_random_value_that_is_at_least_32_chars

# Public booking compatibility identifier. Storage normalizes tenant/account inputs
# to canonical company_id before authorization/persistence.
BOOKING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# AI (Anthropic) — required only for AI estimating features that use Anthropic.
ANTHROPIC_API_KEY=
# RECEIPT_PARSE_MODEL=claude-sonnet-4-6

# Worker
WORKER_POLL_MS=30000

# Email (SMTP) — required for portal magic links
APP_URL=http://localhost:3000
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=hello@example.com
SMTP_PASS=your_smtp_password

# Secrets at rest (payment-provider tokens, etc.)
APP_ENCRYPTION_KEY=

# Optional storage / future Storage Fabric
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Web Push (VAPID) — optional
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
