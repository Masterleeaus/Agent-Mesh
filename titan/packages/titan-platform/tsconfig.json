    "src/workforce.ts",
    "src/intelligence.ts",
    "src/business-ops.ts",
    "src/storage/index.ts",
    "src/interface-runtime.ts",
    "src/interface-registry.ts",
    "src/interface-discovery.ts",
    "src/interface-catalog.ts",
    "src/interface-workspace.ts",
    "src/interface-shell.ts",
    "src/interface-local-state.ts",
    "src/interface-storage.ts",
    "src/interface-semantics.ts",
    "src/interface-integrity.ts",
    "src/interface-interaction-handoff.ts",
    "src/interface-boundary-hardening.ts"
  ]
}
