{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"titan.scheduling.recommendation.v1",
  "title":"Titan Scheduling Recommendation Contract",
  "oneOf":[
    {
      "type":"object",
      "required":["schema","company_id","schedule_intent_id","work_item_id","ranked_workers","requires_governed_assignment","requires_fresh_authority_evaluation","automatic_assignment","direct_mutation","execution_permitted","grants_authority"],
      "properties":{
        "schema":{"const":"titan.scheduling.scored-proposal.v1"},
        "company_id":{"type":"string","minLength":1},
        "schedule_intent_id":{"type":"string","minLength":1},
        "work_item_id":{"type":"string","minLength":1},
        "ranked_workers":{"type":"array"},
        "requires_governed_assignment":{"const":true},
        "requires_fresh_authority_evaluation":{"const":true},
        "automatic_assignment":{"const":false},
        "direct_mutation":{"const":false},
        "execution_permitted":{"const":false},
        "grants_authority":{"const":false}
      },
      "additionalProperties":true
    },
    {
      "type":"object",
      "required":["schema","company_id","schedule_intent_id","work_item_id","alternatives","synthetic_calendar_truth","automatic_assignment","direct_mutation","execution_permitted","grants_authority"],
      "properties":{
        "schema":{"const":"titan.scheduling.alternative-windows.v1"},
        "company_id":{"type":"string","minLength":1},
        "schedule_intent_id":{"type":"string","minLength":1},
        "work_item_id":{"type":"string","minLength":1},
        "alternatives":{"type":"array"},
        "synthetic_calendar_truth":{"const":false},
        "automatic_assignment":{"const":false},
        "direct_mutation":{"const":false},
        "execution_permitted":{"const":false},
        "grants_authority":{"const":false}
      },
      "additionalProperties":true
    },
    {
      "type":"object",
      "required":["schema","company_id","schedule_intent_id","work_item_id","recommended_worker_id","recommended_window","requires_governed_assignment","requires_fresh_authority_evaluation","automatic_assignment","direct_mutation","execution_permitted","grants_authority"],
      "properties":{
        "schema":{"const":"titan.scheduling.reschedule-recommendation.v1"},
        "company_id":{"type":"string","minLength":1},
        "schedule_intent_id":{"type":"string","minLength":1},
        "work_item_id":{"type":"string","minLength":1},
        "recommended_worker_id":{"type":"string","minLength":1},
        "recommended_window":{"type":"object","required":["starts_at","ends_at"]},
        "requires_governed_assignment":{"const":true},
        "requires_fresh_authority_evaluation":{"const":true},
        "automatic_assignment":{"const":false},
        "direct_mutation":{"const":false},
        "execution_permitted":{"const":false},
        "grants_authority":{"const":false}
      },
      "additionalProperties":true
    }
  ]
}
