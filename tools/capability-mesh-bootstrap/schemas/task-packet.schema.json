{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Titan Capability Mesh Task Packet",
  "type": "object",
  "required": [
    "task_id",
    "objective",
    "status",
    "priority",
    "dependencies",
    "acceptance_gates",
    "claim"
  ],
  "properties": {
    "task_id": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PROPOSED",
        "PARTIAL",
        "IMPLEMENTED",
        "VERIFIED",
        "BLOCKED",
        "SUPERSEDED"
      ]
    },
    "priority": {
      "type": "integer"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owned_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shared_areas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptance_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "description",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "enum": [
              "TODO",
              "PASS",
              "FAIL",
              "BLOCKED"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "UNCLAIMED",
            "ACTIVE",
            "RELEASED"
          ]
        },
        "claim_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
