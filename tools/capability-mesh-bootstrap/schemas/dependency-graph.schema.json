{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Titan Capability Dependency Graph",
  "type": "object",
  "required": [
    "nodes",
    "edges"
  ],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "GOAL",
              "CAPABILITY",
              "CONTRACT",
              "MODULE",
              "TEST",
              "EVIDENCE"
            ]
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "type"
        ],
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "type": {
            "enum": [
              "DEPENDS_ON",
              "IMPLEMENTS",
              "TESTED_BY",
              "EVIDENCED_BY",
              "SUPERSEDES"
            ]
          }
        }
      }
    }
  }
}
