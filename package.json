{
  "name": "titan-zero",
  "private": true,
  "version": "0.1.0",
  "description": "Titan Zero — AI-native field service business operating system",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter @titan-zero/web --filter @titan-zero/worker dev",
    "dev:web": "pnpm --filter @titan-zero/web dev",
    "dev:worker": "pnpm --filter @titan-zero/worker dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r --if-present test:integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "gate": "bash scripts/gate.sh",
    "gate:fast": "bash scripts/gate.sh --fast",
    "db:migrate": "bash scripts/db-migrate.sh",
    "db:seed": "bash scripts/db-seed.sh",
    "db:portability": "node scripts/db-portability-report.mjs",
    "db:portability:strict": "node scripts/db-portability-report.mjs --strict",
    "desktop:prepare": "pnpm --filter @titan-zero/web build && node scripts/prepare-windows-runtime.mjs",
    "desktop:dist:win": "pnpm desktop:prepare && electron-builder --win nsis --x64"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "typescript": "^5.7.2",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "main": "electron/main.cjs"
}
