{
  "type": "object",
  "required": ["draft_reply", "suggested_owner", "owner_rationale", "draft_status"],
  "properties": {
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "draft_reply": {
      "type": "string"
    },
    "block_reason": {
      "type": "string"
    },
    "draft_status": {
      "type": "string",
      "enum": ["ready_to_send", "needs_human_call", "needs_rewrite", "blocked"]
    },
    "owner_rationale": {
      "type": "string"
    },
    "suggested_owner": {
      "type": "string"
    },
    "alternatives_considered": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional list of other technicians considered and why they weren't picked."
    }
  }
}
