{
  "harness": "agents/harness/run.ts",
  "type": "ai-runtime",
  "version": "2.0.0",
  "runtime": "@resqai/runtime",
  "provider": "lemma",
  "model": null,
  "execution": {
    "mode": "auto",
    "maxConcurrency": 1
  },
  "retry": {
    "maxAttempts": 3,
    "baseDelayMs": 1000,
    "backoffFactor": 2
  },
  "timeout": {
    "defaultMs": 120000,
    "hardLimitMs": 300000
  },
  "confidence": {
    "autoExecute": 0.85,
    "requireReview": 0.6,
    "escalate": 0.3
  },
  "context": {
    "maxTokens": 64000,
    "windowStrategy": "hybrid",
    "compressionEnabled": true
  },
  "memory": {
    "enabled": true,
    "type": "conversation",
    "maxMessages": 30
  },
  "cost": {
    "budgetCents": 5000,
    "alertThreshold": 0.8
  },
  "command": "npx tsx agents/harness/run.ts request-classifier <input-file>"
}
