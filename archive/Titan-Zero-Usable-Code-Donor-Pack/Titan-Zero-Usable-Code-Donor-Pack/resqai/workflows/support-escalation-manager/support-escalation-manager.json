{
  "name": "support-escalation-manager",
  "description": "Detects tickets that require escalation and coordinates the escalation process. Uses request-classifier to evaluate the ticket, operations-coordinator for coordination planning, human approval for sign-off, resolution-advisor for resolution recommendations, and update_ticket_record for finalizing with audit logging.",
  "version": "1.0.0",
  "status": "active",
  "retry_policy": {
    "max_retries": 3,
    "initial_delay_ms": 2000,
    "backoff_multiplier": 2,
    "max_delay_ms": 30000,
    "retryable_errors": ["timeout", "transient", "workload_error"]
  },
  "idempotency": {
    "key_source": "start.metadata.record_id",
    "ttl_seconds": 86400
  },
  "start": {
    "type": "DATASTORE_EVENT",
    "config": {
      "table_name": "tickets",
      "operations": ["UPDATE"]
    }
  },
  "nodes": [
    {
      "id": "classify_ticket",
      "type": "AGENT",
      "label": "Classify Ticket",
      "config": {
        "agent_name": "request-classifier",
        "input_mapping": {
          "ticket_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          },
          "force_reclassify": {
            "type": "literal",
            "value": true
          }
        }
      }
    },
    {
      "id": "check_escalation",
      "type": "DECISION",
      "label": "Escalation Required?",
      "config": {
        "rules": [
          {
            "condition": "classify_ticket.urgency == `urgent`",
            "next_node_id": "coordinate_escalation"
          },
          {
            "condition": "classify_ticket.urgency == `high`",
            "next_node_id": "coordinate_escalation"
          },
          {
            "condition": "classify_ticket.request_type == `complaint`",
            "next_node_id": "coordinate_escalation"
          },
          {
            "condition": "classify_ticket.classification_status == `needs_human_review`",
            "next_node_id": "coordinate_escalation"
          }
        ]
      }
    },
    {
      "id": "coordinate_escalation",
      "type": "AGENT",
      "label": "Coordinate Escalation",
      "config": {
        "agent_name": "operations-coordinator",
        "input_mapping": {
          "scope": {
            "type": "literal",
            "value": "escalation"
          },
          "today": {
            "type": "expression",
            "value": "start.metadata.event_occurred_at"
          },
          "max_actions": {
            "type": "literal",
            "value": 5
          },
          "create_tasks": {
            "type": "literal",
            "value": true
          }
        }
      }
    },
    {
      "id": "human_approval",
      "type": "FORM",
      "label": "Human Approval",
      "config": {
        "input_schema": {
          "type": "object",
          "properties": {
            "approved": {
              "type": "boolean",
              "description": "Approve the escalation plan"
            },
            "assigned_to": {
              "type": "string",
              "description": "Personnel assigned to handle the escalation"
            },
            "notes": {
              "type": "string",
              "description": "Notes or instructions for handling the escalation"
            }
          },
          "required": ["approved"]
        }
      }
    },
    {
      "id": "route_approval",
      "type": "DECISION",
      "label": "Approved?",
      "config": {
        "rules": [
          {
            "condition": "human_approval.approved == `true`",
            "next_node_id": "resolve_escalation"
          }
        ]
      }
    },
    {
      "id": "resolve_escalation",
      "type": "AGENT",
      "label": "Resolution Advisory",
      "config": {
        "agent_name": "resolution-advisor",
        "input_mapping": {
          "dispute_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          }
        }
      }
    },
    {
      "id": "update_ticket",
      "type": "FUNCTION",
      "label": "Update Ticket Record",
      "config": {
        "function_name": "update_ticket_record",
        "input_mapping": {
          "ticket_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          },
          "status": {
            "type": "literal",
            "value": "closed"
          },
          "approved_to_send": {
            "type": "literal",
            "value": false
          },
          "assigned_to": {
            "type": "expression",
            "value": "human_approval.assigned_to",
            "optional": true
          },
          "human_notes": {
            "type": "expression",
            "value": "human_approval.notes",
            "optional": true
          },
          "resolution_summary": {
            "type": "expression",
            "value": "resolve_escalation.recommended_resolution",
            "optional": true
          },
          "resolution_reasoning": {
            "type": "expression",
            "value": "resolve_escalation.reasoning",
            "optional": true
          }
        }
      }
    },
    {
      "id": "end_approved",
      "type": "END",
      "label": "Escalation Resolved"
    },
    {
      "id": "end_rejected",
      "type": "END",
      "label": "Escalation Rejected"
    },
    {
      "id": "end_no_escalation",
      "type": "END",
      "label": "No Escalation Needed"
    }
  ],
  "edges": [
    {
      "id": "e_classify_to_check",
      "source": "classify_ticket",
      "target": "check_escalation"
    },
    {
      "id": "e_check_escalation",
      "source": "check_escalation",
      "target": "coordinate_escalation",
      "label": "escalation needed"
    },
    {
      "id": "e_check_default",
      "source": "check_escalation",
      "target": "end_no_escalation",
      "label": "no escalation needed (default)"
    },
    {
      "id": "e_coordinate_to_approval",
      "source": "coordinate_escalation",
      "target": "human_approval"
    },
    {
      "id": "e_approval_to_route",
      "source": "human_approval",
      "target": "route_approval"
    },
    {
      "id": "e_route_approved",
      "source": "route_approval",
      "target": "resolve_escalation",
      "label": "approved"
    },
    {
      "id": "e_route_default",
      "source": "route_approval",
      "target": "end_rejected",
      "label": "rejected (default)"
    },
    {
      "id": "e_resolve_to_update",
      "source": "resolve_escalation",
      "target": "update_ticket"
    },
    {
      "id": "e_update_to_end",
      "source": "update_ticket",
      "target": "end_approved"
    }
  ],
  "timeout_ms": 300000,
  "visibility": "POD"
}