{
  "type": "object",
  "title": "AccountHealthScanResult",
  "required": ["today", "scan_params", "totals", "by_health", "top_risk", "all_rows"],
  "properties": {
    "today": { "type": "string", "title": "Today" },
    "scan_params": { "type": "object", "title": "Scan Params" },
    "totals": { "type": "object", "title": "Totals" },
    "by_health": { "type": "object", "title": "By Health" },
    "top_risk": { "type": "array", "items": { "$ref": "#/$defs/AccountHealthRow" }, "title": "Top Risk" },
    "all_rows": { "type": "array", "items": { "$ref": "#/$defs/AccountHealthRow" }, "title": "All Rows" }
  },
  "$defs": {
    "AccountHealthRow": {
      "type": "object",
      "required": ["account_id", "customer_id", "name", "relationship_status", "prior_health", "new_health", "new_score", "score_delta", "open_followups", "overdue_followups", "open_disputes", "signposts", "summary"],
      "properties": {
        "account_id": { "type": "string" }, "customer_id": { "type": "string" }, "name": { "type": "string" },
        "relationship_status": { "type": "string" }, "prior_health": { "type": "string" }, "new_health": { "type": "string" },
        "prior_score": { "anyOf": [{ "type": "number" }, { "type": "null" }] }, "new_score": { "type": "number" },
        "score_delta": { "type": "number" }, "open_followups": { "type": "integer" }, "overdue_followups": { "type": "integer" },
        "open_disputes": { "type": "integer" },
        "days_since_last_contact": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
        "days_since_last_service": { "anyOf": [{ "type": "integer" }, { "type": "null" }] },
        "signposts": { "type": "array", "items": { "$ref": "#/$defs/AccountRiskSignal" } },
        "summary": { "type": "string" }
      }
    },
    "AccountRiskSignal": {
      "type": "object",
      "required": ["label", "weight"],
      "properties": {
        "label": { "type": "string", "enum": ["no_contact", "no_service", "high_overdue_followups", "open_dispute", "critical_dispute", "single_service_relationship", "stale_relationship_status"] },
        "weight": { "type": "number" }
      }
    }
  }
}
