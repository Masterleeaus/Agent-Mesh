{
  "type": "object",
  "title": "CheckTicketUrgencyInput",
  "required": ["ticket_id", "urgency"],
  "properties": {
    "ticket_id": {
      "type": "string",
      "description": "The ticket UUID to check urgency for."
    },
    "urgency": {
      "type": "string",
      "enum": ["low", "normal", "high", "urgent"],
      "description": "Urgency value from request-classifier output."
    },
    "classification_status": {
      "type": "string",
      "description": "Classification status from request-classifier for context."
    }
  }
}
