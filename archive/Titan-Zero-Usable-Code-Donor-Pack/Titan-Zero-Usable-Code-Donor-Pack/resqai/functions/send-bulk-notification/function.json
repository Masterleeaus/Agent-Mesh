{
  "name": "send_bulk_notification",
  "description": "Dispatches notifications to multiple recipients, recording each result.",
  "type": "API",
  "input_type_name": "SendBulkNotificationInput",
  "output_type_name": "SendBulkNotificationOutput",
  "python_packages": ["pydantic", "lemma-sdk"],
  "code": { "$file": "src/handler.py" },
  "visibility": "POD",
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "notifications_v2",
        "permission_ids": ["datastore.record.create", "datastore.record.read"]
      },
      {
        "resource_type": "connector",
        "resource_name": "resqai-gmail",
        "permission_ids": ["connector.use"]
      },
      {
        "resource_type": "connector",
        "resource_name": "resqai-twilio",
        "permission_ids": ["connector.use"]
      }
    ]
  }
}