{
  "name": "authenticate_user",
  "description": "Authenticates a user by email against stored records, validates auth provider if specified, updates last_login_at, creates a session, and logs the operation.",
  "type": "API",
  "input_type_name": "AuthenticateUserInput",
  "output_type_name": "AuthenticateUserOutput",
  "python_packages": ["pydantic", "lemma-sdk"],
  "visibility": "POD",
  "code": { "$file": "src/handler.py" },
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "users_v2",
        "permission_ids": ["datastore.record.read", "datastore.record.write", "datastore.table.read"]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "user_sessions_v2",
        "permission_ids": ["datastore.record.create", "datastore.table.read"]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "operations_log",
        "permission_ids": ["datastore.record.read", "datastore.record.create", "datastore.table.read"]
      }
    ]
  }
}
