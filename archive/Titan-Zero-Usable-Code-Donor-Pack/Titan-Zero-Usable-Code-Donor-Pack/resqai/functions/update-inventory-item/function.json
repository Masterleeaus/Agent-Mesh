{
  "name": "update_inventory_item",
  "description": "Updates an inventory item, records quantity changes as inventory transactions, and logs the operation.",
  "type": "API",
  "input_type_name": "UpdateInventoryItemInput",
  "output_type_name": "UpdateInventoryItemOutput",
  "python_packages": ["pydantic", "lemma-sdk"],
  "code": { "$file": "src/handler.py" },
  "visibility": "POD",
  "permissions": {
    "grants": [
      {
        "resource_type": "datastore_table",
        "resource_name": "inventory_items_v2",
        "permission_ids": ["datastore.record.read", "datastore.record.write", "datastore.table.read"]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "inventory_transactions_v2",
        "permission_ids": ["datastore.record.create"]
      },
      {
        "resource_type": "datastore_table",
        "resource_name": "operations_log",
        "permission_ids": ["datastore.record.create"]
      }
    ]
  }
}