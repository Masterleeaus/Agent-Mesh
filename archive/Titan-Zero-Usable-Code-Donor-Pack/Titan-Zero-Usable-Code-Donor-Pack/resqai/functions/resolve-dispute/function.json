{
  "name": "resolve_dispute",
  "description": "Finalizes a dispute resolution after human approval. Updates the dispute record with the approved resolution, updates the related ticket status, and writes an audit log entry. Idempotent — re-running with the same inputs overwrites state without duplicating side effects.",
  "type": "API",
  "visibility": "POD",
  "python_packages": ["pydantic", "lemma-sdk"],
  "code": { "$file": "src/handler.py" },
  "permissions": { "grants": [
    { "resource_type": "datastore_table", "resource_name": "disputes",
      "permission_ids": ["datastore.record.read", "datastore.record.write", "datastore.table.read"] },
    { "resource_type": "datastore_table", "resource_name": "tickets",
      "permission_ids": ["datastore.record.read", "datastore.record.write", "datastore.table.read"] },
    { "resource_type": "datastore_table", "resource_name": "operations_log",
      "permission_ids": ["datastore.record.read", "datastore.record.write", "datastore.table.read"] },
    { "resource_type": "connector", "resource_name": "discord",
      "permission_ids": ["connector.use"] },
    { "resource_type": "connector", "resource_name": "gmail",
      "permission_ids": ["connector.use"] }
  ] }
}
