{
  "type": "object",
  "required": ["analysis_status", "recommended_resolution", "resolution_reason", "confidence", "reasoning", "alternative_resolutions"],
  "properties": {
    "reasoning": {
      "type": "string"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "next_steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "block_reason": {
      "type": "string"
    },
    "analysis_status": {
      "type": "string",
      "enum": ["ready_for_review", "insufficient_evidence", "safety_escalation", "legal_escalation", "already_analyzed", "blocked"]
    },
    "resolution_reason": {
      "type": "string"
    },
    "linked_customer_id": {
      "type": "string"
    },
    "requires_human_call": {
      "type": "boolean"
    },
    "linked_appointment_id": {
      "type": "string"
    },
    "recommended_resolution": {
      "type": "string",
      "enum": ["full_refund", "partial_refund", "redo_service", "discount_credit", "no_action", "escalate_legal"]
    },
    "alternative_resolutions": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
