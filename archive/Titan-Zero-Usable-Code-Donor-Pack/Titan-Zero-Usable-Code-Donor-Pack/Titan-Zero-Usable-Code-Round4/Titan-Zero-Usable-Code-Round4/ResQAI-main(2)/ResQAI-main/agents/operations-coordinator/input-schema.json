{
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "enum": ["daily", "weekly", "urgent_only"],
      "description": "Horizon for the run. Default 'daily'."
    },
    "today": {
      "type": "string",
      "description": "ISO date (YYYY-MM-DD). Defaults to today."
    },
    "max_actions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25,
      "description": "Cap on recommendations. Default 8."
    },
    "create_tasks": {
      "type": "boolean",
      "description": "If true, create tasks rows for non-trivial recommendations (default true)."
    }
  }
}
