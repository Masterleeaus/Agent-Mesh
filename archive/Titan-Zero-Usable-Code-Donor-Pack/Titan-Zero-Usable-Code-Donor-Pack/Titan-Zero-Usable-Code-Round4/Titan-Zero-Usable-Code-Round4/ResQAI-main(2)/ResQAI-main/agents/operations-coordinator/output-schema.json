{
  "type": "object",
  "required": ["summary", "recommendations"],
  "properties": {
    "summary": {
      "type": "string"
    },
    "tasks_created": {
      "type": "array",
      "items": { "type": "object" }
    },
    "summary_counts": {
      "type": "object",
      "properties": {
        "high_count": { "type": "integer" },
        "urgent_count": { "type": "integer" },
        "overdue_task_count": { "type": "integer" },
        "stuck_customer_count": { "type": "integer" },
        "unconfirmed_appointment_count": { "type": "integer" }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "summary", "priority"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["create_appointment", "assign_technician", "schedule_followup", "create_task", "reassign_visit"]
          },
          "summary": { "type": "string" },
          "task_id": { "type": "string" },
          "priority": {
            "type": "string",
            "enum": ["low", "normal", "high", "urgent"]
          },
          "rationale": { "type": "string" },
          "target_id": { "type": "string" }
        }
      }
    },
    "coordination_status": {
      "type": "string",
      "enum": ["ok", "attention_needed", "crisis", "unavailable_data"]
    }
  }
}
