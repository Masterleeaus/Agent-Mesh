{
  "name": "customer-satisfaction-monitor",
  "description": "Daily monitor that collects recently resolved tickets, assesses satisfaction via operations-coordinator, routes dissatisfied customers through support-manager review and resolution-advisor analysis, and writes audit entries.",
  "version": "1.0.0",
  "status": "active",
  "retry_policy": {
    "max_retries": 3,
    "initial_delay_ms": 2000,
    "backoff_multiplier": 2,
    "max_delay_ms": 30000,
    "retryable_errors": ["timeout", "transient", "workload_error"]
  },
  "idempotency": {
    "key_source": "start.metadata.time",
    "ttl_seconds": 86400
  },
  "start": {
    "type": "SCHEDULED",
    "config": {
      "cron": "0 8 * * *",
      "schedule_type": "CRON"
    }
  },
  "nodes": [
    {
      "id": "collect_tickets",
      "type": "FUNCTION",
      "label": "Collect Resolved Tickets",
      "config": {
        "function_name": "collect_resolved_tickets",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "today": { "type": "expression", "value": "start.metadata.time", "optional": true },
          "lookback_days": { "type": "literal", "value": 7 },
          "max_tickets": { "type": "literal", "value": 50 }
        }
      }
    },
    {
      "id": "any_tickets",
      "type": "DECISION",
      "label": "Any Resolved Tickets?",
      "config": {
        "rules": [
          {
            "condition": "collect_tickets.total_found > `0`",
            "next_node_id": "coordinate_review"
          }
        ]
      }
    },
    {
      "id": "coordinate_review",
      "type": "AGENT",
      "label": "Review with Operations Coordinator",
      "config": {
        "agent_name": "operations-coordinator",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "scope": { "type": "literal", "value": "daily" },
          "today": { "type": "expression", "value": "start.metadata.time", "optional": true },
          "max_actions": { "type": "literal", "value": 10 },
          "create_tasks": { "type": "literal", "value": false }
        }
      }
    },
    {
      "id": "satisfaction_check",
      "type": "DECISION",
      "label": "Customer Satisfied?",
      "config": {
        "rules": [
          {
            "condition": "coordinate_review.coordination_status == `ok`",
            "next_node_id": "end_satisfied"
          }
        ]
      }
    },
    {
      "id": "manager_review",
      "type": "FORM",
      "label": "Support Manager Review",
      "config": {
        "input_schema": {
          "type": "object",
          "title": "Support Manager Review",
          "properties": {
            "approved": {
              "type": "boolean",
              "description": "Approve escalation for further review"
            },
            "notes": {
              "type": "string",
              "description": "Manager notes or instructions"
            }
          },
          "required": ["approved"]
        },
        "prefill": {
          "ticket_summary": { "type": "expression", "value": "collect_tickets.tickets" },
          "coordinator_findings": { "type": "expression", "value": "coordinate_review.recommendations" }
        }
      }
    },
    {
      "id": "approval_check",
      "type": "DECISION",
      "label": "Approve Escalation?",
      "config": {
        "rules": [
          {
            "condition": "manager_review.approved == `true`",
            "next_node_id": "analyze_resolution"
          }
        ]
      }
    },
    {
      "id": "analyze_resolution",
      "type": "AGENT",
      "label": "Analyze with Resolution Advisor",
      "config": {
        "agent_name": "resolution-advisor",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "dispute_id": { "type": "expression", "value": "collect_tickets.tickets[0].ticket_id" },
          "force_reanalysis": { "type": "literal", "value": true }
        }
      }
    },
    {
      "id": "finalize",
      "type": "FUNCTION",
      "label": "Update Ticket & Audit Log",
      "config": {
        "function_name": "update_ticket_record",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "ticket_id": { "type": "expression", "value": "collect_tickets.tickets[0].ticket_id" },
          "status": { "type": "literal", "value": "closed" },
          "human_notes": { "type": "expression", "value": "manager_review.notes", "optional": true },
          "resolution_summary": { "type": "expression", "value": "analyze_resolution.recommended_resolution", "optional": true },
          "resolution_reasoning": { "type": "expression", "value": "analyze_resolution.reasoning", "optional": true },
          "analysis_status": { "type": "expression", "value": "analyze_resolution.analysis_status", "optional": true }
        }
      }
    },
    {
      "id": "end_no_tickets",
      "type": "END",
      "label": "No Tickets"
    },
    {
      "id": "end_satisfied",
      "type": "END",
      "label": "Customer Satisfied"
    },
    {
      "id": "end_rejected",
      "type": "END",
      "label": "Escalation Rejected"
    },
    {
      "id": "end_complete",
      "type": "END",
      "label": "Escalation Complete"
    }
  ],
  "edges": [
    {
      "id": "e-collect-to-decision",
      "source": "collect_tickets",
      "target": "any_tickets"
    },
    {
      "id": "e-yes-tickets",
      "source": "any_tickets",
      "target": "coordinate_review",
      "label": "has tickets"
    },
    {
      "id": "e-no-tickets",
      "source": "any_tickets",
      "target": "end_no_tickets",
      "label": "default"
    },
    {
      "id": "e-coordinate-to-check",
      "source": "coordinate_review",
      "target": "satisfaction_check"
    },
    {
      "id": "e-satisfied",
      "source": "satisfaction_check",
      "target": "end_satisfied",
      "label": "satisfied"
    },
    {
      "id": "e-dissatisfied",
      "source": "satisfaction_check",
      "target": "manager_review",
      "label": "default"
    },
    {
      "id": "e-review-to-decision",
      "source": "manager_review",
      "target": "approval_check"
    },
    {
      "id": "e-approved",
      "source": "approval_check",
      "target": "analyze_resolution",
      "label": "approved"
    },
    {
      "id": "e-rejected",
      "source": "approval_check",
      "target": "end_rejected",
      "label": "default"
    },
    {
      "id": "e-analyze-to-finalize",
      "source": "analyze_resolution",
      "target": "finalize"
    },
    {
      "id": "e-finalize-to-end",
      "source": "finalize",
      "target": "end_complete"
    }
  ],
  "timeout_ms": 600000,
  "visibility": "POD"
}
