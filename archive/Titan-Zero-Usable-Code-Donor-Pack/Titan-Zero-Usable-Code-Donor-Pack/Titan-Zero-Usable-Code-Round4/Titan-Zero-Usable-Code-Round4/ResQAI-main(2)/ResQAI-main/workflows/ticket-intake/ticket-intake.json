{
  "name": "ticket-intake",
  "description": "Ticket intake workflow: classifies incoming tickets, routes urgent tickets directly to human approval while coordinating normal tickets through ops, then generates a resolution recommendation and finalizes the ticket record. V2 graph format with full edge connectivity, retry policy, timeout, audit, and notification support.",
  "status": "active",
  "version": "2.0.0",
  "retry_policy": {
    "max_retries": 3,
    "initial_delay_ms": 2000,
    "backoff_multiplier": 2,
    "max_delay_ms": 30000,
    "retryable_errors": ["timeout", "transient", "workload_error"]
  },
  "timeout_ms": 300000,
  "idempotency": {
    "key_source": "trigger.ticket_id",
    "ttl_seconds": 86400
  },
  "start": {
    "type": "EVENT",
    "config": {
      "event_name": "ticket.created"
    }
  },
  "nodes": [
    {
      "id": "classify_ticket",
      "type": "AGENT",
      "label": "Classify Request",
      "config": {
        "agent_name": "request-classifier",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "ticket_id": { "type": "expression", "value": "start.metadata.record_id" }
        }
      }
    },
    {
      "id": "route_classification",
      "type": "DECISION",
      "label": "Classification OK?",
      "config": {
        "rules": [
          {
            "condition": "classify_ticket.classification_status == `needs_human_review` || classify_ticket.classification_status == `unparseable`",
            "next_node_id": "human_escalation"
          }
        ]
      }
    },
    {
      "id": "check_urgency",
      "type": "FUNCTION",
      "label": "Check Ticket Urgency",
      "config": {
        "function_name": "check_ticket_urgency",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "ticket_id": { "type": "expression", "value": "start.metadata.record_id" },
          "urgency": { "type": "expression", "value": "classify_ticket.urgency", "optional": true },
          "classification_status": { "type": "expression", "value": "classify_ticket.classification_status", "optional": true }
        }
      }
    },
    {
      "id": "route_urgency",
      "type": "DECISION",
      "label": "Route by Urgency",
      "config": {
        "rules": [
          {
            "condition": "check_urgency.routing == `urgent` || check_urgency.routing == `high`",
            "next_node_id": "human_approval"
          }
        ]
      }
    },
    {
      "id": "coordinate_ticket",
      "type": "AGENT",
      "label": "Coordinate Operations",
      "config": {
        "agent_name": "operations-coordinator",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "scope": { "type": "literal", "value": "daily" },
          "today": { "type": "expression", "value": "start.metadata.time", "optional": true },
          "max_actions": { "type": "literal", "value": 5 },
          "create_tasks": { "type": "literal", "value": true }
        }
      }
    },
    {
      "id": "human_approval",
      "type": "FORM",
      "label": "Human Approval",
      "config": {
        "input_schema": {
          "type": "object",
          "properties": {
            "approved": {
              "type": "boolean",
              "description": "Approve the ticket resolution"
            },
            "assigned_to": {
              "type": "string",
              "description": "Person assigned to handle this ticket"
            },
            "notes": {
              "type": "string",
              "description": "Notes or instructions"
            },
            "decision": {
              "type": "string",
              "enum": ["approved", "rejected", "needs_revision"],
              "description": "Decision on this ticket"
            }
          },
          "required": ["approved"]
        },
        "prefill": {
          "ticket_id": { "type": "expression", "value": "start.metadata.record_id" },
          "urgency": { "type": "expression", "value": "classify_ticket.urgency" },
          "request_type": { "type": "expression", "value": "classify_ticket.request_type" },
          "suggested_next_action": { "type": "expression", "value": "classify_ticket.recommended_next_action" },
          "coordination_summary": { "type": "expression", "value": "coordinate_ticket.summary", "optional": true }
        }
      }
    },
    {
      "id": "route_approval",
      "type": "DECISION",
      "label": "Approved?",
      "config": {
        "rules": [
          {
            "condition": "human_approval.approved == `true` && (human_approval.decision == `approved` || human_approval.decision == ``)",
            "next_node_id": "resolve_ticket"
          },
          {
            "condition": "human_approval.decision == `needs_revision`",
            "next_node_id": "coordinate_ticket"
          }
        ]
      }
    },
    {
      "id": "resolve_ticket",
      "type": "AGENT",
      "label": "Resolution Advisory",
      "config": {
        "agent_name": "resolution-advisor",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "dispute_id": { "type": "expression", "value": "start.metadata.record_id" }
        }
      }
    },
    {
      "id": "route_resolution",
      "type": "DECISION",
      "label": "Route Resolution",
      "config": {
        "rules": [
          {
            "condition": "resolve_ticket.analysis_status == `insufficient_evidence` || resolve_ticket.analysis_status == `safety_escalation` || resolve_ticket.analysis_status == `legal_escalation`",
            "next_node_id": "human_escalation"
          }
        ]
      }
    },
    {
      "id": "update_ticket",
      "type": "FUNCTION",
      "label": "Update Ticket Record",
      "config": {
        "function_name": "update_ticket_record",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "ticket_id": { "type": "expression", "value": "start.metadata.record_id" },
          "status": { "type": "literal", "value": "approved_to_send" },
          "approved_to_send": { "type": "literal", "value": true },
          "assigned_to": { "type": "expression", "value": "human_approval.assigned_to", "optional": true },
          "human_notes": { "type": "expression", "value": "human_approval.notes", "optional": true },
          "resolution_summary": { "type": "expression", "value": "resolve_ticket.recommended_resolution", "optional": true },
          "resolution_reasoning": { "type": "expression", "value": "resolve_ticket.reasoning", "optional": true },
          "analysis_status": { "type": "expression", "value": "resolve_ticket.analysis_status", "optional": true }
        }
      }
    },
    {
      "id": "human_escalation",
      "type": "FORM",
      "label": "Human Escalation",
      "config": {
        "input_schema": {
          "type": "object",
          "properties": {
            "resolved": {
              "type": "boolean",
              "description": "Mark the escalation as resolved"
            },
            "action_taken": {
              "type": "string",
              "description": "Action taken to resolve the escalation"
            },
            "resolution_notes": {
              "type": "string",
              "description": "Detailed notes on the resolution"
            }
          },
          "required": ["resolved"]
        },
        "prefill": {
          "ticket_id": { "type": "expression", "value": "start.metadata.record_id" },
          "classification_status": { "type": "expression", "value": "classify_ticket.classification_status" },
          "urgency": { "type": "expression", "value": "classify_ticket.urgency" },
          "reasoning": { "type": "expression", "value": "classify_ticket.reasoning" },
          "resolution_analysis": { "type": "expression", "value": "resolve_ticket.analysis_status", "optional": true }
        }
      }
    },
    {
      "id": "end_approved",
      "type": "END",
      "label": "Ticket Resolved"
    },
    {
      "id": "end_escalated",
      "type": "END",
      "label": "Escalated to Human"
    }
  ],
  "edges": [
    { "id": "e-classify-to-route", "source": "classify_ticket", "target": "route_classification" },
    { "id": "e-classified", "source": "route_classification", "target": "check_urgency", "label": "default (classified)" },
    { "id": "e-unparseable", "source": "route_classification", "target": "human_escalation", "label": "needs_human_review / unparseable" },
    { "id": "e-urgency-check", "source": "check_urgency", "target": "route_urgency" },
    { "id": "e-urgent", "source": "route_urgency", "target": "human_approval", "label": "urgent / high" },
    { "id": "e-normal", "source": "route_urgency", "target": "coordinate_ticket", "label": "default" },
    { "id": "e-coordinate-to-approval", "source": "coordinate_ticket", "target": "human_approval" },
    { "id": "e-approval-to-route", "source": "human_approval", "target": "route_approval" },
    { "id": "e-approved", "source": "route_approval", "target": "resolve_ticket", "label": "approved" },
    { "id": "e-rejected", "source": "route_approval", "target": "human_approval", "label": "default (rejected / retry)" },
    { "id": "e-needs-revision", "source": "route_approval", "target": "coordinate_ticket", "label": "needs_revision" },
    { "id": "e-resolve-to-route", "source": "resolve_ticket", "target": "route_resolution" },
    { "id": "e-auto-resolve", "source": "route_resolution", "target": "update_ticket", "label": "default" },
    { "id": "e-escalate-resolution", "source": "route_resolution", "target": "human_escalation", "label": "insufficient_evidence / safety / legal" },
    { "id": "e-update-to-end", "source": "update_ticket", "target": "end_approved" },
    { "id": "e-escalation-to-end", "source": "human_escalation", "target": "end_escalated" }
  ],
  "visibility": "POD",
  "enabled": true
}
