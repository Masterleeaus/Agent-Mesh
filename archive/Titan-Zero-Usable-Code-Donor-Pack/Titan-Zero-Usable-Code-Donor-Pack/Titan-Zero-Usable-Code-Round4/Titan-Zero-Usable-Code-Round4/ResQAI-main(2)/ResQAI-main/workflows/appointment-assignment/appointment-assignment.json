{
  "name": "appointment-assignment",
  "description": "Automatically suggests the best technician for newly created appointments using tech-suggester, routes through manager approval, and updates the appointment record with audit logging.",
  "version": "1.0.0",
  "status": "active",
  "retry_policy": {
    "max_retries": 3,
    "initial_delay_ms": 2000,
    "backoff_multiplier": 2,
    "max_delay_ms": 30000,
    "retryable_errors": ["timeout", "transient", "workload_error"]
  },
  "idempotency": {
    "key_source": "start.metadata.record_id",
    "ttl_seconds": 86400
  },
  "start": {
    "type": "DATASTORE_EVENT",
    "config": {
      "table_name": "appointments",
      "operations": ["INSERT"]
    }
  },
  "nodes": [
    {
      "id": "suggest_technician",
      "type": "AGENT",
      "label": "Suggest Best Technician",
      "config": {
        "agent_name": "tech-suggester",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "service_type": { "type": "expression", "value": "start.payload.service_type" },
          "appointment_date": { "type": "expression", "value": "start.payload.date" },
          "customer_notes": { "type": "expression", "value": "start.payload.notes", "optional": true }
        }
      }
    },
    {
      "id": "check_suggestion",
      "type": "DECISION",
      "label": "Technician Suggested?",
      "config": {
        "rules": [
          {
            "condition": "suggest_technician.pick_tech_name != `` && suggest_technician.score >= `50`",
            "next_node_id": "manager_approval"
          }
        ]
      }
    },
    {
      "id": "manager_approval",
      "type": "FORM",
      "label": "Manager Approve Technician",
      "config": {
        "assignee_pod_member_id_expression": "start.metadata.user_id",
        "input_schema": {
          "type": "object",
          "title": "Approve Technician Assignment",
          "properties": {
            "approve": {
              "type": "boolean",
              "description": "Approve assigning the suggested technician"
            },
            "override_technician": {
              "type": "string",
              "description": "If rejecting, specify an alternative technician name"
            },
            "notes": {
              "type": "string",
              "description": "Manager notes or instructions"
            }
          },
          "required": ["approve"]
        },
        "prefill": {
          "appointment_id": { "type": "expression", "value": "start.metadata.record_id" },
          "service_type": { "type": "expression", "value": "start.payload.service_type" },
          "suggested_technician": { "type": "expression", "value": "suggest_technician.pick_tech_name" },
          "confidence_score": { "type": "expression", "value": "suggest_technician.score" },
          "rationale": { "type": "expression", "value": "suggest_technician.rationale" }
        }
      }
    },
    {
      "id": "approval_check",
      "type": "DECISION",
      "label": "Approved?",
      "config": {
        "rules": [
          {
            "condition": "manager_approval.approve == `true`",
            "next_node_id": "assign_technician"
          }
        ]
      }
    },
    {
      "id": "assign_technician",
      "type": "FUNCTION",
      "label": "Assign Technician",
      "config": {
        "function_name": "assign_appointment_technician",
        "retry_policy": {
          "max_retries": 3,
          "initial_delay_ms": 2000,
          "backoff_multiplier": 2,
          "max_delay_ms": 30000,
          "retryable_errors": ["timeout", "transient", "workload_error"]
        },
        "input_mapping": {
          "appointment_id": { "type": "expression", "value": "start.metadata.record_id" },
          "technician_name": { "type": "expression", "value": "manager_approval.override_technician || suggest_technician.pick_tech_name" },
          "technician_id": { "type": "literal", "value": null },
          "manager_notes": { "type": "expression", "value": "manager_approval.notes", "optional": true }
        }
      }
    },
    {
      "id": "end_no_suggestion",
      "type": "END",
      "label": "No Technician Available"
    },
    {
      "id": "end_rejected",
      "type": "END",
      "label": "Assignment Rejected"
    },
    {
      "id": "end_assigned",
      "type": "END",
      "label": "Technician Assigned"
    }
  ],
  "edges": [
    {
      "id": "e-suggest-to-check",
      "source": "suggest_technician",
      "target": "check_suggestion"
    },
    {
      "id": "e-tech-found",
      "source": "check_suggestion",
      "target": "manager_approval",
      "label": "tech suggested"
    },
    {
      "id": "e-no-tech",
      "source": "check_suggestion",
      "target": "end_no_suggestion",
      "label": "default"
    },
    {
      "id": "e-approval-to-check",
      "source": "manager_approval",
      "target": "approval_check"
    },
    {
      "id": "e-approved",
      "source": "approval_check",
      "target": "assign_technician",
      "label": "approved"
    },
    {
      "id": "e-rejected",
      "source": "approval_check",
      "target": "end_rejected",
      "label": "default"
    },
    {
      "id": "e-assign-to-end",
      "source": "assign_technician",
      "target": "end_assigned"
    }
  ],
  "timeout_ms": 120000,
  "visibility": "POD"
}
