{
  "start": {
    "type": "DATASTORE_EVENT",
    "config": {
      "table_name": "tickets",
      "operations": ["INSERT"]
    }
  },
  "nodes": [
    {
      "id": "classify_ticket",
      "type": "AGENT",
      "label": "Classify Request",
      "config": {
        "agent_name": "request-classifier",
        "input_mapping": {
          "ticket_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          }
        }
      }
    },
    {
      "id": "classify_decision",
      "type": "DECISION",
      "label": "Classification OK?",
      "config": {
        "rules": [
          {
            "condition": "classify_ticket.output.classification_status == 'unparseable'",
            "next_node_id": "human_escalation"
          },
          {
            "condition": "classify_ticket.output.classification_status == 'needs_human_review'",
            "next_node_id": "human_escalation"
          }
        ]
      }
    },
    {
      "id": "check_urgency",
      "type": "FUNCTION",
      "label": "Check Ticket Urgency",
      "config": {
        "function_name": "check_ticket_urgency",
        "input_mapping": {
          "ticket_id": {
            "type": "expression",
            "value": "classify_ticket.output.ticket_id"
          },
          "urgency": {
            "type": "expression",
            "value": "classify_ticket.output.urgency"
          }
        }
      }
    },
    {
      "id": "urgency_decision",
      "type": "DECISION",
      "label": "Urgent?",
      "config": {
        "rules": [
          {
            "condition": "check_urgency.output.is_urgent == `true`",
            "next_node_id": "human_approval"
          }
        ]
      }
    },
    {
      "id": "coordinate_ticket",
      "type": "AGENT",
      "label": "Coordinate Operations",
      "config": {
        "agent_name": "operations-coordinator",
        "input_mapping": {
          "scope": {
            "type": "literal",
            "value": "daily"
          },
          "max_actions": {
            "type": "literal",
            "value": 5
          },
          "create_tasks": {
            "type": "literal",
            "value": true
          }
        }
      }
    },
    {
      "id": "human_approval",
      "type": "FORM",
      "label": "Human Approval",
      "config": {
        "input_schema": {
          "type": "object",
          "properties": {
            "approved": {
              "type": "boolean"
            },
            "assigned_to": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            },
            "decision": {
              "type": "string",
              "enum": ["approved", "rejected"]
            }
          },
          "required": ["approved", "decision"]
        }
      }
    },
    {
      "id": "approval_decision",
      "type": "DECISION",
      "label": "Approved?",
      "config": {
        "rules": [
          {
            "condition": "human_approval.approved == `true`",
            "next_node_id": "resolve_ticket"
          },
          {
            "condition": "human_approval.decision == 'rejected'",
            "next_node_id": "human_approval"
          }
        ]
      }
    },
    {
      "id": "resolve_ticket",
      "type": "AGENT",
      "label": "Resolution Advisory",
      "config": {
        "agent_name": "resolution-advisor",
        "input_mapping": {
          "dispute_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          }
        }
      }
    },
    {
      "id": "resolution_decision",
      "type": "DECISION",
      "label": "Resolution Status",
      "config": {
        "rules": [
          {
            "condition": "resolve_ticket.output.analysis_status == 'insufficient_evidence'",
            "next_node_id": "human_escalation"
          },
          {
            "condition": "resolve_ticket.output.analysis_status == 'safety_escalation'",
            "next_node_id": "human_escalation"
          },
          {
            "condition": "resolve_ticket.output.analysis_status == 'legal_escalation'",
            "next_node_id": "human_escalation"
          }
        ]
      }
    },
    {
      "id": "update_ticket",
      "type": "FUNCTION",
      "label": "Update Ticket Record",
      "config": {
        "function_name": "update_ticket_record",
        "input_mapping": {
          "ticket_id": {
            "type": "expression",
            "value": "start.metadata.record_id"
          },
          "status": {
            "type": "literal",
            "value": "approved_to_send"
          },
          "approved_to_send": {
            "type": "literal",
            "value": true
          },
          "assigned_to": {
            "type": "expression",
            "value": "human_approval.assigned_to",
            "optional": true
          },
          "human_notes": {
            "type": "expression",
            "value": "human_approval.notes",
            "optional": true
          }
        }
      }
    },
    {
      "id": "human_escalation",
      "type": "FORM",
      "label": "Human Escalation",
      "config": {
        "input_schema": {
          "type": "object",
          "properties": {
            "resolved": {
              "type": "boolean"
            },
            "action_taken": {
              "type": "string"
            },
            "resolution_notes": {
              "type": "string"
            }
          },
          "required": ["resolved"]
        }
      }
    },
    {
      "id": "end",
      "type": "END",
      "label": "Complete"
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "classify_ticket",
      "target": "classify_decision"
    },
    {
      "id": "e2",
      "source": "classify_decision",
      "target": "check_urgency",
      "label": "classified"
    },
    {
      "id": "e3",
      "source": "classify_decision",
      "target": "human_escalation",
      "label": "unparseable or needs review"
    },
    {
      "id": "e4",
      "source": "check_urgency",
      "target": "urgency_decision"
    },
    {
      "id": "e5",
      "source": "urgency_decision",
      "target": "human_approval",
      "label": "urgent"
    },
    {
      "id": "e6",
      "source": "urgency_decision",
      "target": "coordinate_ticket",
      "label": "not urgent"
    },
    {
      "id": "e7",
      "source": "coordinate_ticket",
      "target": "human_approval"
    },
    {
      "id": "e8",
      "source": "human_approval",
      "target": "approval_decision"
    },
    {
      "id": "e9",
      "source": "approval_decision",
      "target": "resolve_ticket",
      "label": "approved"
    },
    {
      "id": "e10",
      "source": "approval_decision",
      "target": "human_approval",
      "label": "rejected"
    },
    {
      "id": "e11",
      "source": "resolve_ticket",
      "target": "resolution_decision"
    },
    {
      "id": "e12",
      "source": "resolution_decision",
      "target": "update_ticket",
      "label": "ready for review or analyzed"
    },
    {
      "id": "e13",
      "source": "resolution_decision",
      "target": "human_escalation",
      "label": "insufficient/safety/legal"
    },
    {
      "id": "e14",
      "source": "update_ticket",
      "target": "end"
    },
    {
      "id": "e15",
      "source": "human_escalation",
      "target": "end"
    }
  ]
}
