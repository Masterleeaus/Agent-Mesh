{
  "type": "object",
  "title": "FlagSlippingFollowupsResult",
  "required": ["today", "window", "counts", "top"],
  "properties": {
    "today": { "type": "string", "title": "Today" },
    "window": { "type": "object", "title": "window" },
    "counts": { "type": "object", "title": "Counts" },
    "top": { "type": "array", "items": { "$ref": "#/$defs/SlippingFollowup" }, "title": "Top" }
  },
  "$defs": {
    "SlippingFollowup": {
      "type": "object",
      "required": ["followup_id", "account_id", "customer_id", "customer_name", "subject", "type", "status", "priority", "due_date", "days_overdue", "severity", "bucket"],
      "properties": {
        "followup_id": { "type": "string" }, "account_id": { "type": "string" }, "customer_id": { "type": "string" },
        "customer_name": { "type": "string" }, "subject": { "type": "string" }, "type": { "type": "string" },
        "status": { "type": "string" }, "priority": { "type": "string" }, "due_date": { "type": "string" },
        "days_overdue": { "type": "integer" },
        "severity": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
        "bucket": { "type": "string", "enum": ["overdue", "due_today", "due_soon"] },
        "owner": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "related_appointment_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "related_ticket_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] },
        "notes": { "anyOf": [{ "type": "string" }, { "type": "null" }] }
      }
    }
  }
}
