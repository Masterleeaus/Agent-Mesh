{
  "name": "create_followup",
  "description": "Creates a new followup record with status 'pending' for a given account. Validates that the account exists and increments the account's open_followups counter. Writes an audit entry to the operations log.",
  "type": "API",
  "input_type_name": "CreateFollowupInput",
  "output_type_name": "CreateFollowupOutput",
  "python_packages": ["pydantic", "lemma-sdk"],
  "code": { "$file": "src/handler.py" },
  "visibility": "POD",
  "permissions": {
    "grants": [
      { "resource_type": "datastore_table", "resource_name": "accounts_v2", "permission_ids": ["datastore.record.read", "datastore.record.write", "datastore.table.read"] },
      { "resource_type": "datastore_table", "resource_name": "followups_v2", "permission_ids": ["datastore.record.create", "datastore.table.read"] },
      { "resource_type": "datastore_table", "resource_name": "operations_log", "permission_ids": ["datastore.record.create"] }
    ]
  }
}
