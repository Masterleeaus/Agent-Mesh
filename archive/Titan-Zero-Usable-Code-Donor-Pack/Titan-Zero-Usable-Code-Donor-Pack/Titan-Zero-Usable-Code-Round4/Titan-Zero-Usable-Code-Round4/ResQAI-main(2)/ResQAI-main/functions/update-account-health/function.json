{
  "name": "update_account_health",
  "description": "Updates the health score and health category for an account. Records the previous health value before applying the update. Creates an account_health_scans_v2 record with scan details and risk factors. Writes an audit entry to the operations log.",
  "type": "API",
  "input_type_name": "UpdateAccountHealthInput",
  "output_type_name": "UpdateAccountHealthOutput",
  "python_packages": ["pydantic", "lemma-sdk"],
  "code": { "$file": "src/handler.py" },
  "visibility": "POD",
  "permissions": {
    "grants": [
      { "resource_type": "datastore_table", "resource_name": "accounts_v2", "permission_ids": ["datastore.record.read", "datastore.record.write", "datastore.table.read"] },
      { "resource_type": "datastore_table", "resource_name": "account_health_scans_v2", "permission_ids": ["datastore.record.create", "datastore.table.read"] },
      { "resource_type": "datastore_table", "resource_name": "operations_log", "permission_ids": ["datastore.record.create"] }
    ]
  }
}
