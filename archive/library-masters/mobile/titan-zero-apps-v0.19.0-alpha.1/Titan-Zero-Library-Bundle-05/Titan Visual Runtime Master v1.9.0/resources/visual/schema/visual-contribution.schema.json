{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "provider",
    "surfaces",
    "treatment"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]+$"
    },
    "provider": {
      "type": "string"
    },
    "surfaces": {
      "type": "array",
      "items": {
        "enum": [
          "zero",
          "go",
          "hub"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "treatment": {
      "type": "object"
    },
    "capabilityRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
