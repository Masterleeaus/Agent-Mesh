{
  "id": "mobile-profile",
  "name": "Profile",
  "description": "Premium Mobilekit-derived profile preview.",
  "version": "1.1",
  "surface": "mobile",
  "authority": "presentation-only",
  "persistence": {
    "scope": "message",
    "historyLimit": 20
  },
  "state": {},
  "root": "shell",
  "elements": {
    "shell": {
      "type": "mobile-app-shell",
      "props": {
        "safeArea": true
      },
      "children": [
        "header",
        "body",
        "nav"
      ]
    },
    "header": {
      "type": "mobile-app-header",
      "props": {
        "title": "Profile",
        "leftLabel": "‹",
        "rightLabel": "",
        "tone": "transparent",
        "sticky": true
      }
    },
    "body": {
      "type": "stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "person",
        "stats",
        "details",
        "chips"
      ]
    },
    "nav": {
      "type": "mobile-bottom-nav",
      "props": {
        "active": "home",
        "items": [
          {
            "id": "home",
            "label": "Home",
            "icon": "⌂"
          },
          {
            "id": "activity",
            "label": "Activity",
            "icon": "◎"
          },
          {
            "id": "profile",
            "label": "Profile",
            "icon": "○"
          }
        ]
      }
    },
    "person": {
      "type": "profile-hero",
      "props": {
        "name": "Alex Taylor",
        "subtitle": "Customer",
        "badge": "Active",
        "bio": "Manage bookings, invoices and messages from one place."
      }
    },
    "details": {
      "type": "mobile-list",
      "props": {
        "inset": true,
        "items": [
          {
            "title": "Email",
            "value": "alex@example.com"
          },
          {
            "title": "Phone",
            "value": "0400 000 000"
          },
          {
            "title": "Preferred service",
            "value": "Weekly clean"
          }
        ]
      }
    },
    "chips": {
      "type": "stack",
      "props": {
        "gap": "sm"
      },
      "children": [
        "chip1",
        "chip2"
      ]
    },
    "chip1": {
      "type": "chip",
      "props": {
        "label": "Verified",
        "tone": "success"
      }
    },
    "chip2": {
      "type": "chip",
      "props": {
        "label": "Premium customer",
        "tone": "primary",
        "outline": true
      }
    },
    "stats": {
      "type": "profile-stat-grid",
      "props": {
        "items": [
          {
            "label": "Bookings",
            "value": "4"
          },
          {
            "label": "Invoices",
            "value": "2"
          },
          {
            "label": "Messages",
            "value": "8"
          }
        ]
      }
    }
  },
  "meta": {
    "premium": true,
    "source": "Mobilekit-v2.9.1-MIT",
    "company_boundary": "company_id"
  }
}
