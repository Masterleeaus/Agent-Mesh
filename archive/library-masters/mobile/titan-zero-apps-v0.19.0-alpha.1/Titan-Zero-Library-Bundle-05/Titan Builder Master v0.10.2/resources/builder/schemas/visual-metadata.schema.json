{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "visualTreatment": {
      "type": "string",
      "maxLength": 128
    },
    "motionPreset": {
      "type": "string",
      "maxLength": 128
    },
    "transitionPreset": {
      "type": "string",
      "maxLength": 128
    },
    "assetRole": {
      "type": "string",
      "maxLength": 128
    },
    "iconRole": {
      "type": "string",
      "maxLength": 128
    },
    "mediaRole": {
      "type": "string",
      "maxLength": 128
    },
    "loadingTreatment": {
      "type": "string",
      "maxLength": 128
    },
    "emptyTreatment": {
      "type": "string",
      "maxLength": 128
    },
    "errorTreatment": {
      "type": "string",
      "maxLength": 128
    },
    "densityRules": {
      "type": "object"
    },
    "reducedMotionFallback": {
      "type": "object"
    },
    "contrastRules": {
      "type": "object"
    },
    "visualCapabilityRequirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "resourcePolicy": {
      "type": "object",
      "properties": {
        "cacheMode": {
          "type": "string",
          "enum": [
            "default",
            "prefer-offline",
            "no-cache"
          ]
        },
        "maxAgeSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 604800
        },
        "integrityRequired": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "visualPriority": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "capabilityFallbackOrder": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    }
  },
  "propertyNames": {
    "not": {
      "enum": [
        "script",
        "javascript",
        "html",
        "css",
        "eval",
        "sql",
        "credentials",
        "credential",
        "token",
        "secret",
        "rawUrl",
        "raw_url",
        "permission",
        "permissions",
        "authorization",
        "authorisation",
        "entitlement",
        "autonomy",
        "risk",
        "cost",
        "privacy",
        "capability",
        "capabilities"
      ]
    }
  },
  "additionalProperties": false,
  "$id": "titan://builder/schema/visual-metadata/v1",
  "title": "Titan Builder Visual Metadata Contract v1",
  "x-titan-contract-version": "1.1"
}
