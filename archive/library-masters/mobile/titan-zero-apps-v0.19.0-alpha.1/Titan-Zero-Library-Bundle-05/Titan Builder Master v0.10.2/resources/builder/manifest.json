{
  "id": "titan-builder",
  "name": "Titan Builder",
  "version": "0.9.3-agent4-convergence",
  "authority": "presentation-only",
  "default_page": "cleaning-business-dashboard",
  "default_theme": "titan-light",
  "supported_surfaces": [
    "public-website",
    "admin-dashboard",
    "customer-portal",
    "worker-mobile",
    "property-operations",
    "reports",
    "chat",
    "canvas",
    "inline-generative-ui"
  ],
  "allowed_actions": [
    "navigate",
    "open-modal",
    "open-drawer",
    "filter",
    "search",
    "sort",
    "export-preview",
    "builder.edit",
    "builder.preview",
    "builder.publish",
    "builder.rollback",
    "builder.theme.update",
    "builder.application.read",
    "builder.application.create",
    "builder.application.configure",
    "builder.brand.read",
    "builder.brand.update",
    "builder.navigation.read",
    "builder.navigation.update",
    "builder.theme.read",
    "builder.features.read",
    "builder.features.update",
    "builder.page.read",
    "builder.page.configure",
    "builder.vertical.apply",
    "builder.validate",
    "builder.readiness",
    "crm.customer.create",
    "crm.work_order.create",
    "crm.work_order.assign",
    "crm.work_order.task.complete",
    "communications.message.send",
    "mobile.application.open",
    "mobile.application.install",
    "onboarding.response.submit",
    "titanmoney.quotes.create",
    "titanmoney.invoices.issue",
    "zeropay.payment-intent.create",
    "state.set",
    "state.toggle",
    "state.increment",
    "state.append",
    "state.remove",
    "state.merge",
    "state.reset",
    "state.undo",
    "state.redo",
    "ui.next-page",
    "ui.previous-page",
    "ui.expand",
    "ui.collapse",
    "ui.copy-spec",
    "ui.open-canvas",
    "form.submit-preview"
  ],
  "rules": [
    "Actions are declarative intents only and must be re-authorized by the owning capability layer.",
    "CRM is authoritative for operational business state; Builder consumes read-only DTO contracts only.",
    "Builder is presentation-only and never writes CRM records directly.",
    "TitanAI may propose Builder specs but cannot bypass normalisation, validation, action/data-source governance, preview, versioning or approval.",
    "Interaction Engine owns wizard state and branching; Builder renders its presentation contract.",
    "Titan Mobile runtimes own device, PWA, offline, sync and notification execution.",
    "Titan Connect owns communications credentials, OAuth, webhooks and delivery.",
    "Generated pages use validated preview fixtures or authorised read DTOs and never bypass CRM authorization.",
    "No component may include credentials, provider secrets, executable HTML or arbitrary JavaScript.",
    "Customer, field, owner and onboarding are surface templates; verticals are configuration overlays, not duplicated engines.",
    "Titan Apps: Builder is the single canonical Builder for zero, go and hub; legacy Chatbot Builder artifacts are migration/provenance only.",
    "Advanced visual execution is delegated to Titan Apps: Visual Runtime through governed declarative metadata.",
    "Onboarding is a zero-surface journey, not a canonical application surface."
  ],
  "collections": {
    "components": "components",
    "blocks": "blocks",
    "pages": "pages",
    "themes": "themes",
    "mock_data": "mock-data",
    "prompts": "prompts",
    "specs": "specs",
    "schemas": "schemas",
    "templates": "templates",
    "surfaces": "surfaces",
    "data_sources": "data-sources",
    "verticals": "verticals",
    "actions": "actions"
  },
  "generative_ui": {
    "spec_version": "1.1",
    "format": "flat-element-map",
    "inline_fence": "titan-ui",
    "max_elements": 250,
    "edit_modes": [
      "merge",
      "patch"
    ],
    "backward_compatible_versions": [
      "1.0"
    ],
    "state_persistence": "local-message-scope",
    "history": true,
    "watch_bindings": true,
    "read_data_bindings": true,
    "repair_endpoint": "/titan-builder/api/generative-ui/repair"
  },
  "surface_profiles": {
    "chat": {
      "density": "compact",
      "max_columns": 2,
      "preferred_elements": 30,
      "expandable": true
    },
    "mobile": {
      "density": "compact",
      "max_columns": 1,
      "preferred_elements": 24,
      "expandable": false
    },
    "canvas": {
      "density": "comfortable",
      "max_columns": 4,
      "preferred_elements": 80,
      "expandable": false
    },
    "page": {
      "density": "comfortable",
      "max_columns": 4,
      "preferred_elements": 120,
      "expandable": false
    },
    "builder": {
      "density": "comfortable",
      "max_columns": 4,
      "preferred_elements": 120,
      "expandable": false
    },
    "preview": {
      "density": "comfortable",
      "max_columns": 3,
      "preferred_elements": 60,
      "expandable": true
    }
  },
  "host": "titan-zero",
  "offline_state": "runtime-owned-by-TitanMobileCore; builder previews are non-authoritative",
  "default_template": "owner",
  "supported_product_surfaces": [
    "customer",
    "field",
    "owner",
    "onboarding"
  ],
  "allowed_data_sources": [
    "crm-business-hours",
    "crm-business-locations",
    "crm-business-services",
    "crm-customer-bookings",
    "crm-customer-invoices",
    "crm-customer-quotes",
    "crm-customer-work-orders",
    "crm-field-assigned-work",
    "crm-field-minimum-customer-context",
    "crm-field-minimum-site-context",
    "crm-field-tasks",
    "crm-owner-approvals",
    "crm-owner-finance-summary",
    "crm-owner-operations-summary",
    "crm-owner-schedule-capacity",
    "invoices-customer",
    "jobs-assigned",
    "jobs-customer",
    "operations-summary",
    "schedule-capacity",
    "tasks-assigned"
  ],
  "premium": {
    "mobilekit": {
      "enabled": true,
      "source": "Mobilekit v2.9.1",
      "license": "MIT (user-confirmed)",
      "component_count": 54,
      "page_preset_count": 18,
      "theme": "mobilekit-premium",
      "template": "mobilekit-premium",
      "runtime_ownership": "presentation-only; PWA/offline remains TitanMobileCore",
      "features": [
        "mobile-shell",
        "advanced-forms",
        "disclosure-feedback",
        "progress-loading",
        "commerce-media",
        "dark-mode",
        "rtl",
        "application-patterns",
        "authentication-profile",
        "messaging",
        "invoice-checkout",
        "content-system-states",
        "vertical-app-templates"
      ],
      "block_count": 9,
      "app_template_count": 6
    }
  },
  "application_definition": {
    "schema": "titan-mobile-application-definition/1",
    "persistence": "builder-project-meta+pages+publish-snapshots",
    "tenant_key": "company_id",
    "runtime_ownership": "Titan Mobile ecosystem",
    "source_code_forks": false
  },
  "integration_authority": {
    "business_data": "CRM",
    "reasoning": "TitanAI",
    "wizard_state": "Interaction Engine",
    "communications": "Titan Connect",
    "chatbot_configuration": "Chatbot Builder",
    "mobile_runtime": "Titan Mobile"
  },
  "canonical_app_surfaces": [
    "zero",
    "go",
    "hub"
  ],
  "compatibility_surface_aliases": {
    "base": "zero",
    "owner": "zero",
    "command": "zero",
    "bos": "zero",
    "business": "zero",
    "manager": "zero",
    "field": "go",
    "worker": "go",
    "customer": "hub"
  },
  "journeys": {
    "onboarding": {
      "surface": "zero",
      "journey": "onboarding"
    }
  }
}
