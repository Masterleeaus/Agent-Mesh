{
  "id": "mobile-lockscreen",
  "name": "Locked",
  "description": "Premium Mobilekit-derived locked preview.",
  "version": "1.1",
  "surface": "mobile",
  "authority": "presentation-only",
  "persistence": {
    "scope": "message",
    "historyLimit": 20
  },
  "state": {
    "pin": ""
  },
  "root": "shell",
  "elements": {
    "shell": {
      "type": "mobile-app-shell",
      "props": {
        "safeArea": true
      },
      "children": [
        "header",
        "body",
        "nav"
      ]
    },
    "header": {
      "type": "mobile-app-header",
      "props": {
        "title": "Locked",
        "leftLabel": "‹",
        "rightLabel": "",
        "tone": "transparent",
        "sticky": true
      }
    },
    "body": {
      "type": "stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "profile",
        "pin",
        "unlock"
      ]
    },
    "nav": {
      "type": "mobile-bottom-nav",
      "props": {
        "active": "home",
        "items": [
          {
            "id": "home",
            "label": "Home",
            "icon": "⌂"
          },
          {
            "id": "activity",
            "label": "Activity",
            "icon": "◎"
          },
          {
            "id": "profile",
            "label": "Profile",
            "icon": "○"
          }
        ]
      }
    },
    "profile": {
      "type": "entity-card",
      "props": {
        "title": "Your workspace",
        "subtitle": "Session locked",
        "initials": "TZ",
        "status": "Locked",
        "tone": "warning"
      }
    },
    "pin": {
      "type": "mobile-input",
      "props": {
        "label": "PIN",
        "type": "password",
        "statePath": "/pin"
      }
    },
    "unlock": {
      "type": "button",
      "props": {
        "label": "Unlock preview",
        "variant": "primary"
      },
      "on": {
        "press": {
          "action": "navigate",
          "params": {
            "destination": "auth.unlock"
          }
        }
      }
    }
  },
  "meta": {
    "premium": true,
    "source": "Mobilekit-v2.9.1-MIT",
    "company_boundary": "company_id"
  }
}
