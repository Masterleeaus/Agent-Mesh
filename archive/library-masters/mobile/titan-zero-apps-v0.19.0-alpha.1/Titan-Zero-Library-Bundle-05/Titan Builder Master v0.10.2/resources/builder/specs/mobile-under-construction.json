{
  "id": "mobile-under-construction",
  "name": "Coming soon",
  "description": "Premium Mobilekit-derived coming soon preview.",
  "version": "1.1",
  "surface": "mobile",
  "authority": "presentation-only",
  "persistence": {
    "scope": "message",
    "historyLimit": 20
  },
  "state": {},
  "root": "shell",
  "elements": {
    "shell": {
      "type": "mobile-app-shell",
      "props": {
        "safeArea": true
      },
      "children": [
        "header",
        "body",
        "nav"
      ]
    },
    "header": {
      "type": "mobile-app-header",
      "props": {
        "title": "Coming soon",
        "leftLabel": "‹",
        "rightLabel": "",
        "tone": "transparent",
        "sticky": true
      }
    },
    "body": {
      "type": "stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "notice",
        "notify"
      ]
    },
    "nav": {
      "type": "mobile-bottom-nav",
      "props": {
        "active": "home",
        "items": [
          {
            "id": "home",
            "label": "Home",
            "icon": "⌂"
          },
          {
            "id": "activity",
            "label": "Activity",
            "icon": "◎"
          },
          {
            "id": "profile",
            "label": "Profile",
            "icon": "○"
          }
        ]
      }
    },
    "notice": {
      "type": "summary-banner",
      "props": {
        "eyebrow": "Launching soon",
        "title": "Something new is being built",
        "description": "A branded pre-launch page for new products, locations or services."
      }
    },
    "notify": {
      "type": "install-prompt",
      "props": {
        "title": "Stay ready",
        "description": "Install-prompt preview can be configured by TitanMobileCore when supported.",
        "platform": "PWA preview"
      }
    }
  },
  "meta": {
    "premium": true,
    "source": "Mobilekit-v2.9.1-MIT",
    "company_boundary": "company_id"
  }
}
