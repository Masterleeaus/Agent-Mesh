{
  "id": "mobile-about",
  "name": "About",
  "description": "Premium Mobilekit-derived about preview.",
  "version": "1.1",
  "surface": "mobile",
  "authority": "presentation-only",
  "persistence": {
    "scope": "message",
    "historyLimit": 20
  },
  "state": {},
  "root": "shell",
  "elements": {
    "shell": {
      "type": "mobile-app-shell",
      "props": {
        "safeArea": true
      },
      "children": [
        "header",
        "body",
        "nav"
      ]
    },
    "header": {
      "type": "mobile-app-header",
      "props": {
        "title": "About",
        "leftLabel": "‹",
        "rightLabel": "",
        "tone": "transparent",
        "sticky": true
      }
    },
    "body": {
      "type": "stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "hero",
        "copy",
        "values"
      ]
    },
    "nav": {
      "type": "mobile-bottom-nav",
      "props": {
        "active": "home",
        "items": [
          {
            "id": "home",
            "label": "Home",
            "icon": "⌂"
          },
          {
            "id": "activity",
            "label": "Activity",
            "icon": "◎"
          },
          {
            "id": "profile",
            "label": "Profile",
            "icon": "○"
          }
        ]
      }
    },
    "hero": {
      "type": "summary-banner",
      "props": {
        "eyebrow": "About",
        "title": "Built for mobile businesses",
        "description": "Premium shell preset adapted from Mobilekit into Titan Builder."
      }
    },
    "copy": {
      "type": "text",
      "props": {
        "text": "Use this page for business story, service coverage, trust signals and team information."
      }
    },
    "values": {
      "type": "mobile-list",
      "props": {
        "items": [
          {
            "title": "Fast",
            "detail": "Mobile-first interactions"
          },
          {
            "title": "Safe",
            "detail": "Validated declarative UI"
          },
          {
            "title": "Connected",
            "detail": "Titan platform intents"
          }
        ]
      }
    }
  },
  "meta": {
    "premium": true,
    "source": "Mobilekit-v2.9.1-MIT",
    "company_boundary": "company_id"
  }
}
