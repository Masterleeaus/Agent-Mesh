{
  "id": "mobile-forgot-password",
  "name": "Reset password",
  "description": "Premium Mobilekit-derived reset password preview.",
  "version": "1.1",
  "surface": "mobile",
  "authority": "presentation-only",
  "persistence": {
    "scope": "message",
    "historyLimit": 20
  },
  "state": {
    "email": ""
  },
  "root": "shell",
  "elements": {
    "shell": {
      "type": "mobile-app-shell",
      "props": {
        "safeArea": true
      },
      "children": [
        "header",
        "body",
        "nav"
      ]
    },
    "header": {
      "type": "mobile-app-header",
      "props": {
        "title": "Reset password",
        "leftLabel": "‹",
        "rightLabel": "",
        "tone": "transparent",
        "sticky": true
      }
    },
    "body": {
      "type": "stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "copy",
        "email",
        "reset"
      ]
    },
    "nav": {
      "type": "mobile-bottom-nav",
      "props": {
        "active": "home",
        "items": [
          {
            "id": "home",
            "label": "Home",
            "icon": "⌂"
          },
          {
            "id": "activity",
            "label": "Activity",
            "icon": "◎"
          },
          {
            "id": "profile",
            "label": "Profile",
            "icon": "○"
          }
        ]
      }
    },
    "copy": {
      "type": "text",
      "props": {
        "text": "Enter your email to prepare a password reset request.",
        "tone": "muted"
      }
    },
    "email": {
      "type": "mobile-input",
      "props": {
        "label": "Email",
        "type": "email",
        "statePath": "/email",
        "validation": [
          {
            "type": "required",
            "message": "Email is required"
          }
        ]
      }
    },
    "reset": {
      "type": "button",
      "props": {
        "label": "Prepare reset",
        "variant": "primary"
      },
      "on": {
        "press": {
          "action": "navigate",
          "params": {
            "destination": "auth.password-reset"
          }
        }
      }
    }
  },
  "meta": {
    "premium": true,
    "source": "Mobilekit-v2.9.1-MIT",
    "company_boundary": "company_id"
  }
}
