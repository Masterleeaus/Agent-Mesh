{
  "id": "titan-onboarding",
  "name": "Titan Onboarding",
  "description": "Provisioning preview for the Onboarding PWA.",
  "version": "1.1",
  "surface": "mobile",
  "authority": "presentation-only",
  "persistence": {
    "scope": "message",
    "historyLimit": 20
  },
  "state": {
    "progress": 0,
    "status": "collecting"
  },
  "root": "shell",
  "elements": {
    "shell": {
      "type": "mobile-app-shell",
      "props": {
        "safeArea": true
      },
      "children": [
        "header",
        "body",
        "nav"
      ]
    },
    "header": {
      "type": "mobile-app-header",
      "props": {
        "title": "Titan Onboarding",
        "tone": "transparent",
        "sticky": true
      }
    },
    "body": {
      "type": "stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "welcome",
        "conversation",
        "progress",
        "review",
        "preview",
        "readiness"
      ]
    },
    "welcome": {
      "type": "summary-banner",
      "props": {
        "eyebrow": "Business setup",
        "title": "Build your Titan apps",
        "description": "Tell Titan about your business. Generated controls remain presentation-only."
      }
    },
    "conversation": {
      "type": "chat-thread",
      "props": {
        "title": "Onboarding conversation",
        "messages": []
      }
    },
    "progress": {
      "type": "mobile-progress",
      "props": {
        "value": {
          "$state": "/progress"
        },
        "label": "Setup progress"
      }
    },
    "review": {
      "type": "approval-card",
      "props": {
        "title": "Review configuration",
        "status": "pending",
        "description": "Confirm structured business and application settings before provisioning."
      }
    },
    "preview": {
      "type": "card",
      "props": {
        "title": "Preview apps",
        "description": "Preview Titan Hub, Titan Go and Titan Command with safe fixtures before publishing."
      }
    },
    "readiness": {
      "type": "system-state",
      "props": {
        "state": "loading",
        "title": "Readiness",
        "message": "Readiness depends on CRM, TitanAI, Interaction Engine and Mobile capabilities."
      }
    },
    "nav": {
      "type": "mobile-bottom-nav",
      "props": {
        "active": "setup",
        "items": [
          {
            "id": "setup",
            "label": "Setup",
            "icon": "◎"
          },
          {
            "id": "apps",
            "label": "Apps",
            "icon": "▣"
          },
          {
            "id": "ready",
            "label": "Ready",
            "icon": "✓"
          }
        ]
      }
    }
  }
}
