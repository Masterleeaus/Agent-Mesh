{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan://builder/schema/contribution-provenance/v1",
  "type": "object",
  "required": [
    "provider",
    "contributionId",
    "contractVersion",
    "company_id"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "contributionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{0,127}$"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "company_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,128}$"
    }
  },
  "additionalProperties": false
}
