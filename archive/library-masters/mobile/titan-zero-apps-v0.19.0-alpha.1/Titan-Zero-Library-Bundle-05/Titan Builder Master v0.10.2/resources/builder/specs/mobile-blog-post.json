{
  "id": "mobile-blog-post",
  "name": "Article",
  "description": "Premium Mobilekit-derived article preview.",
  "version": "1.1",
  "surface": "mobile",
  "authority": "presentation-only",
  "persistence": {
    "scope": "message",
    "historyLimit": 20
  },
  "state": {},
  "root": "shell",
  "elements": {
    "shell": {
      "type": "mobile-app-shell",
      "props": {
        "safeArea": true
      },
      "children": [
        "header",
        "body",
        "nav"
      ]
    },
    "header": {
      "type": "mobile-app-header",
      "props": {
        "title": "Article",
        "leftLabel": "‹",
        "rightLabel": "",
        "tone": "transparent",
        "sticky": true
      }
    },
    "body": {
      "type": "stack",
      "props": {
        "gap": "md"
      },
      "children": [
        "articleHead",
        "articleBody"
      ]
    },
    "nav": {
      "type": "mobile-bottom-nav",
      "props": {
        "active": "home",
        "items": [
          {
            "id": "home",
            "label": "Home",
            "icon": "⌂"
          },
          {
            "id": "activity",
            "label": "Activity",
            "icon": "◎"
          },
          {
            "id": "profile",
            "label": "Profile",
            "icon": "○"
          }
        ]
      }
    },
    "articleHead": {
      "type": "article-header",
      "props": {
        "eyebrow": "Guide",
        "title": "Preparing for your appointment",
        "author": "Titan Team",
        "publishedAt": "9 Aug 2026",
        "readingTime": "4 min"
      }
    },
    "articleBody": {
      "type": "article-body",
      "props": {
        "lead": "Everything you need before your booking.",
        "paragraphs": [
          "Keep access areas clear before the team arrives.",
          "You can message the business directly if anything changes."
        ]
      }
    }
  },
  "meta": {
    "premium": true,
    "source": "Mobilekit-v2.9.1-MIT",
    "company_boundary": "company_id"
  }
}
