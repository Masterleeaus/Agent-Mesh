{
  "wizard": {
    "id": "order_issue_resolution_v1",
    "version": "1.0.0",
    "name": "Order Issue Resolution",
    "capability": "commerce.orders.resolve_issue",
    "permissions": {
      "required_roles": [
        "staff",
        "supervisor",
        "manager",
        "admin"
      ]
    },
    "metadata": {
      "category": "commerce",
      "template_id": "order-issue-resolution",
      "template_version": "1.0.0",
      "verticals": [
        "ecommerce",
        "retail",
        "wholesale"
      ],
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "high",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": [
        {
          "when": {
            "field": "severity",
            "in": [
              "high",
              "critical"
            ]
          },
          "require_fields": [
            "evidence_attachment_ids",
            "approval_id",
            "approved_by",
            "approved_at"
          ],
          "message_prefix": "Missing required serious order issue governance"
        }
      ]
    },
    "steps": [
      {
        "id": "issue",
        "title": "Issue",
        "fields": [
          {
            "id": "order_id",
            "label": "Order ID",
            "type": "text",
            "required": true
          },
          {
            "id": "issue_type",
            "label": "Issue type",
            "type": "text",
            "required": true,
            "options": [
              "late",
              "lost",
              "damaged",
              "incorrect",
              "payment",
              "other"
            ]
          },
          {
            "id": "severity",
            "label": "Severity",
            "type": "text",
            "required": true,
            "options": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        ]
      },
      {
        "id": "resolution",
        "title": "Resolution",
        "fields": [
          {
            "id": "resolution_action",
            "label": "Resolution action",
            "type": "text",
            "required": true
          },
          {
            "id": "customer_contacted",
            "label": "Customer contacted",
            "type": "boolean",
            "required": true
          },
          {
            "id": "resolution_owner_id",
            "label": "Resolution owner",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "evidence",
        "title": "Evidence and approval",
        "fields": [
          {
            "id": "evidence_attachment_ids",
            "label": "Evidence attachments",
            "type": "array",
            "required": false
          },
          {
            "id": "approval_id",
            "label": "Approval ID",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_by",
            "label": "Approved by",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_at",
            "label": "Approved at",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "id": "declaration",
        "title": "Review",
        "fields": [
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
