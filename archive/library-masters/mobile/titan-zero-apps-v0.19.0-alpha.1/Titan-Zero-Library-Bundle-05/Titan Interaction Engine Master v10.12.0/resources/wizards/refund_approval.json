{
  "wizard": {
    "id": "refund_approval_v1",
    "version": "1.0.0",
    "name": "Refund Approval",
    "capability": "commerce.refunds.approve",
    "permissions": {
      "required_roles": [
        "staff",
        "supervisor",
        "manager",
        "admin"
      ]
    },
    "metadata": {
      "category": "commerce",
      "template_id": "refund-approval",
      "template_version": "1.0.0",
      "verticals": [
        "ecommerce",
        "retail",
        "wholesale"
      ],
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "high",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": [
        {
          "when": {
            "field": "refund_amount",
            "gt": 500
          },
          "require_fields": [
            "evidence_attachment_ids",
            "approval_id",
            "approved_by",
            "approved_at"
          ],
          "message_prefix": "Missing required high value refund approval"
        }
      ]
    },
    "steps": [
      {
        "id": "references",
        "title": "Order references",
        "fields": [
          {
            "id": "order_id",
            "label": "Order ID",
            "type": "text",
            "required": true
          },
          {
            "id": "return_id",
            "label": "Return ID",
            "type": "text",
            "required": true
          },
          {
            "id": "customer_id",
            "label": "Customer ID",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "refund",
        "title": "Refund details",
        "fields": [
          {
            "id": "refund_amount",
            "label": "Refund amount",
            "type": "number",
            "required": true,
            "min": 0
          },
          {
            "id": "currency",
            "label": "Currency",
            "type": "text",
            "required": true,
            "options": [
              "AUD",
              "USD",
              "NZD",
              "GBP",
              "EUR"
            ]
          },
          {
            "id": "refund_reason",
            "label": "Refund reason",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "evidence",
        "title": "Evidence and payment",
        "fields": [
          {
            "id": "evidence_attachment_ids",
            "label": "Evidence attachments",
            "type": "array",
            "required": false
          },
          {
            "id": "payment_reference",
            "label": "Payment reference",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "approval",
        "title": "Approval",
        "fields": [
          {
            "id": "approval_id",
            "label": "Approval ID",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_by",
            "label": "Approved by",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_at",
            "label": "Approved at",
            "type": "text",
            "required": false
          },
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
