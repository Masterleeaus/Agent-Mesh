{
  "wizard": {
    "id": "guest_issue_resolution_v1",
    "version": "1.0.0",
    "name": "Guest Issue Resolution",
    "capability": "hospitality.guest_issues.resolve",
    "permissions": {
      "required_roles": [
        "staff",
        "supervisor",
        "manager",
        "admin"
      ]
    },
    "metadata": {
      "category": "hospitality",
      "template_id": "guest-issue-resolution",
      "template_version": "1.0.0",
      "verticals": [
        "hospitality",
        "events",
        "venues"
      ],
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "normal",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": [
        {
          "when": {
            "field": "compensation_value",
            "gt": 250
          },
          "require_fields": [
            "approval_id",
            "approved_by",
            "approved_at"
          ],
          "message_prefix": "Missing required compensation approval"
        }
      ]
    },
    "steps": [
      {
        "id": "issue",
        "title": "Guest issue",
        "fields": [
          {
            "id": "booking_id",
            "label": "Booking ID",
            "type": "text",
            "required": true
          },
          {
            "id": "issue_type",
            "label": "Issue type",
            "type": "text",
            "required": true
          },
          {
            "id": "severity",
            "label": "Severity",
            "type": "text",
            "required": true,
            "options": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          }
        ]
      },
      {
        "id": "resolution",
        "title": "Resolution",
        "fields": [
          {
            "id": "resolution_action",
            "label": "Resolution action",
            "type": "text",
            "required": true
          },
          {
            "id": "compensation_value",
            "label": "Compensation value",
            "type": "number",
            "required": true,
            "min": 0
          },
          {
            "id": "resolution_owner_id",
            "label": "Resolution owner",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "evidence",
        "title": "Evidence and approval",
        "fields": [
          {
            "id": "evidence_attachment_ids",
            "label": "Evidence attachments",
            "type": "array",
            "required": false
          },
          {
            "id": "approval_id",
            "label": "Approval ID",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_by",
            "label": "Approved by",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_at",
            "label": "Approved at",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "id": "declaration",
        "title": "Review",
        "fields": [
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
