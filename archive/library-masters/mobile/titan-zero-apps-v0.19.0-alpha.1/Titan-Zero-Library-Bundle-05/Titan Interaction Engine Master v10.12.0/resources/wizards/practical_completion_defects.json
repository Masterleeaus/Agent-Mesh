{
  "wizard": {
    "id": "practical_completion_defects_v1",
    "version": "1.0.0",
    "name": "Practical Completion and Defects",
    "capability": "crm.work_order.update",
    "permissions": {
      "required_roles": [
        "field_worker",
        "supervisor",
        "manager",
        "admin",
        "owner"
      ]
    },
    "metadata": {
      "category": "construction",
      "template_id": "practical-completion-defects",
      "template_version": "1.0.0",
      "verticals": [
        "trades",
        "construction"
      ],
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ],
      "surfaces": [
        "go",
        "command"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "high",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": [
        {
          "when": {
            "field": "defects_found",
            "equals": true
          },
          "require_fields": [
            "defects",
            "evidence_attachment_ids",
            "rectification_owner_id",
            "rectification_due_at"
          ],
          "message_prefix": "Missing required defect rectification"
        }
      ]
    },
    "steps": [
      {
        "id": "project",
        "title": "Project completion",
        "fields": [
          {
            "id": "project_id",
            "label": "Project ID",
            "type": "text",
            "required": true
          },
          {
            "id": "site_id",
            "label": "Site ID",
            "type": "text",
            "required": true
          },
          {
            "id": "inspection_at",
            "label": "Inspection at",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "completion",
        "title": "Completion assessment",
        "fields": [
          {
            "id": "completion_percentage",
            "label": "Completion percentage",
            "type": "number",
            "required": true,
            "min": 0,
            "max": 100
          },
          {
            "id": "defects_found",
            "label": "Defects found",
            "type": "boolean",
            "required": true
          },
          {
            "id": "defects",
            "label": "Defects",
            "type": "array",
            "required": false
          }
        ]
      },
      {
        "id": "evidence",
        "title": "Evidence and rectification",
        "fields": [
          {
            "id": "evidence_attachment_ids",
            "label": "Evidence attachments",
            "type": "array",
            "required": false
          },
          {
            "id": "rectification_owner_id",
            "label": "Rectification owner",
            "type": "text",
            "required": false
          },
          {
            "id": "rectification_due_at",
            "label": "Rectification due",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "id": "declaration",
        "title": "Review",
        "fields": [
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
