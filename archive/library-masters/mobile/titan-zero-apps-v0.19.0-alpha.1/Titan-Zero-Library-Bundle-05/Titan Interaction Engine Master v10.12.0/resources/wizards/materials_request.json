{
  "wizard": {
    "id": "materials_request_v1",
    "version": "1.0.0",
    "name": "Materials Request",
    "capability": "crm.work_order.material.add",
    "permissions": {
      "required_roles": [
        "field_worker",
        "supervisor",
        "manager",
        "admin",
        "owner"
      ]
    },
    "metadata": {
      "category": "construction",
      "template_id": "materials-request",
      "template_version": "1.0.0",
      "verticals": [
        "trades",
        "construction",
        "field_services"
      ],
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ],
      "surfaces": [
        "go",
        "command"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "normal",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": [
        {
          "when": {
            "field": "urgent",
            "equals": true
          },
          "require_fields": [
            "approval_id"
          ],
          "message_prefix": "Missing required urgent materials approval"
        }
      ]
    },
    "steps": [
      {
        "id": "job",
        "title": "Job and requester",
        "fields": [
          {
            "id": "project_id",
            "label": "Project ID",
            "type": "text",
            "required": true
          },
          {
            "id": "job_id",
            "label": "Job ID",
            "type": "text",
            "required": true
          },
          {
            "id": "requested_by",
            "label": "Requested by",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "materials",
        "title": "Materials",
        "fields": [
          {
            "id": "items",
            "label": "Items",
            "type": "array",
            "required": true
          },
          {
            "id": "needed_by",
            "label": "Needed by",
            "type": "text",
            "required": true
          },
          {
            "id": "urgent",
            "label": "Urgent",
            "type": "boolean",
            "required": true
          }
        ]
      },
      {
        "id": "delivery",
        "title": "Delivery",
        "fields": [
          {
            "id": "delivery_location",
            "label": "Delivery location",
            "type": "text",
            "required": true
          },
          {
            "id": "supplier_preference",
            "label": "Supplier preference",
            "type": "text",
            "required": false
          },
          {
            "id": "approval_id",
            "label": "Approval ID",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "id": "declaration",
        "title": "Review",
        "fields": [
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
