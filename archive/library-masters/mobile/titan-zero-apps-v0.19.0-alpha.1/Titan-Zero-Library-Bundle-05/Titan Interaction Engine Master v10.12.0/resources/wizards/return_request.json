{
  "wizard": {
    "id": "return_request_v1",
    "version": "1.0.0",
    "name": "Return Request",
    "capability": "commerce.returns.request",
    "permissions": {
      "required_roles": [
        "staff",
        "supervisor",
        "manager",
        "admin"
      ]
    },
    "metadata": {
      "category": "commerce",
      "template_id": "return-request",
      "template_version": "1.0.0",
      "verticals": [
        "ecommerce",
        "retail",
        "wholesale"
      ],
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "normal",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": []
    },
    "steps": [
      {
        "id": "order",
        "title": "Order and customer",
        "fields": [
          {
            "id": "order_id",
            "label": "Order ID",
            "type": "text",
            "required": true
          },
          {
            "id": "customer_id",
            "label": "Customer ID",
            "type": "text",
            "required": true
          },
          {
            "id": "requested_at",
            "label": "Requested at",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "request",
        "title": "Return request",
        "fields": [
          {
            "id": "items",
            "label": "Items",
            "type": "array",
            "required": true
          },
          {
            "id": "reason",
            "label": "Reason",
            "type": "text",
            "required": true,
            "options": [
              "damaged_goods",
              "wrong_item",
              "not_as_described",
              "change_of_mind",
              "other"
            ]
          },
          {
            "id": "resolution_requested",
            "label": "Requested resolution",
            "type": "text",
            "required": true,
            "options": [
              "refund",
              "replacement",
              "repair",
              "credit"
            ]
          }
        ]
      },
      {
        "id": "evidence",
        "title": "Evidence and collection",
        "fields": [
          {
            "id": "evidence_attachment_ids",
            "label": "Evidence attachments",
            "type": "array",
            "required": false
          },
          {
            "id": "collection_required",
            "label": "Collection required",
            "type": "boolean",
            "required": true
          },
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
