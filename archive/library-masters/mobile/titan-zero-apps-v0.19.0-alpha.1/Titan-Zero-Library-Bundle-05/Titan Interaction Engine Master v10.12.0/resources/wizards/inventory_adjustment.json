{
  "wizard": {
    "id": "inventory_adjustment_v1",
    "version": "1.0.0",
    "name": "Inventory Adjustment",
    "capability": "inventory.adjustments.record",
    "permissions": {
      "required_roles": [
        "staff",
        "supervisor",
        "manager",
        "admin"
      ]
    },
    "metadata": {
      "category": "inventory",
      "template_id": "inventory-adjustment",
      "template_version": "1.0.0",
      "verticals": [
        "ecommerce",
        "retail",
        "wholesale",
        "field_services"
      ],
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "high",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": [
        {
          "when": {
            "field": "adjustment_type",
            "in": [
              "decrease",
              "write_off"
            ]
          },
          "require_fields": [
            "evidence_attachment_ids"
          ],
          "message_prefix": "Missing required inventory evidence"
        },
        {
          "when": {
            "field": "adjustment_type",
            "in": [
              "decrease",
              "write_off"
            ]
          },
          "require_fields": [
            "approval_id",
            "approved_by",
            "approved_at"
          ],
          "message_prefix": "Missing required approval"
        }
      ]
    },
    "steps": [
      {
        "id": "scope",
        "title": "Inventory scope",
        "fields": [
          {
            "id": "location_id",
            "label": "Location",
            "type": "text",
            "required": true
          },
          {
            "id": "product_id",
            "label": "Product",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "adjustment",
        "title": "Adjustment",
        "fields": [
          {
            "id": "adjustment_type",
            "label": "Adjustment type",
            "type": "text",
            "required": true,
            "options": [
              "increase",
              "decrease",
              "write_off",
              "correction"
            ]
          },
          {
            "id": "quantity_delta",
            "label": "Quantity change",
            "type": "number",
            "required": true
          },
          {
            "id": "reason",
            "label": "Reason",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "evidence",
        "title": "Evidence",
        "fields": [
          {
            "id": "evidence_attachment_ids",
            "label": "Evidence attachments",
            "type": "array",
            "required": false
          },
          {
            "id": "reference_id",
            "label": "Reference ID",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "id": "approval",
        "title": "Approval",
        "fields": [
          {
            "id": "approval_id",
            "label": "Approval ID",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_by",
            "label": "Approved by",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_at",
            "label": "Approved at",
            "type": "text",
            "required": false
          },
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
