{
  "wizard": {
    "id": "maintenance_request_v1",
    "version": "1.0.0",
    "name": "Maintenance Request",
    "capability": "property.maintenance.request",
    "permissions": {
      "required_roles": [
        "staff",
        "supervisor",
        "manager",
        "admin"
      ]
    },
    "metadata": {
      "category": "property",
      "template_id": "maintenance-request",
      "template_version": "1.0.0",
      "verticals": [
        "property_management",
        "facilities",
        "real_estate"
      ],
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "high",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": [
        {
          "when": {
            "field": "priority",
            "equals": "emergency"
          },
          "require_fields": [
            "evidence_attachment_ids",
            "escalation_owner_id"
          ],
          "message_prefix": "Missing required emergency maintenance escalation"
        }
      ]
    },
    "steps": [
      {
        "id": "request",
        "title": "Maintenance request",
        "fields": [
          {
            "id": "property_id",
            "label": "Property ID",
            "type": "text",
            "required": true
          },
          {
            "id": "request_type",
            "label": "Request type",
            "type": "text",
            "required": true
          },
          {
            "id": "priority",
            "label": "Priority",
            "type": "text",
            "required": true,
            "options": [
              "low",
              "normal",
              "high",
              "emergency"
            ]
          }
        ]
      },
      {
        "id": "details",
        "title": "Details",
        "fields": [
          {
            "id": "summary",
            "label": "Summary",
            "type": "text",
            "required": true
          },
          {
            "id": "location_detail",
            "label": "Location detail",
            "type": "text",
            "required": true
          },
          {
            "id": "access_safe",
            "label": "Access safe",
            "type": "boolean",
            "required": true
          }
        ]
      },
      {
        "id": "evidence",
        "title": "Evidence and escalation",
        "fields": [
          {
            "id": "evidence_attachment_ids",
            "label": "Evidence attachments",
            "type": "array",
            "required": false
          },
          {
            "id": "escalation_owner_id",
            "label": "Escalation owner",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "id": "declaration",
        "title": "Review",
        "fields": [
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
