{
  "wizard": {
    "id": "incident_response_v1",
    "version": "1.0.0",
    "name": "Incident Response",
    "capability": "crm.form.submit",
    "permissions": {
      "required_roles": [
        "field_worker",
        "supervisor",
        "manager",
        "admin",
        "owner"
      ]
    },
    "metadata": {
      "category": "assurance",
      "template_id": "incident-response",
      "template_version": "1.0.0",
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "voice"
      ],
      "surfaces": [
        "go",
        "command"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "critical",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": [
        {
          "when": {
            "field": "risk_level",
            "in": [
              "high",
              "critical"
            ]
          },
          "require_fields": [
            "evidence_attachment_ids"
          ],
          "message_prefix": "Missing required risk evidence"
        },
        {
          "when": {
            "field": "risk_level",
            "in": [
              "high",
              "critical"
            ]
          },
          "require_fields": [
            "approval_id",
            "approved_by",
            "approved_at"
          ],
          "message_prefix": "Missing required approval"
        },
        {
          "when": {
            "field": "environmental_impact",
            "equals": true
          },
          "require_fields": [
            "environmental_details"
          ],
          "message_prefix": "Missing required environmental impact"
        }
      ]
    },
    "steps": [
      {
        "id": "location_time",
        "title": "Where and when",
        "fields": [
          {
            "id": "job_id",
            "label": "Job",
            "type": "text",
            "required": false
          },
          {
            "id": "site_id",
            "label": "Site",
            "type": "text",
            "required": true
          },
          {
            "id": "occurred_at",
            "label": "Occurred at",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "classification",
        "title": "Classify the incident",
        "fields": [
          {
            "id": "incident_type",
            "label": "Incident type",
            "type": "text",
            "required": true,
            "options": [
              "injury",
              "property_damage",
              "environmental",
              "security",
              "near_miss",
              "other"
            ]
          },
          {
            "id": "risk_level",
            "label": "Risk level",
            "type": "text",
            "required": true,
            "options": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          {
            "id": "summary",
            "label": "Summary",
            "type": "text",
            "required": true,
            "max": 2000
          }
        ]
      },
      {
        "id": "impact",
        "title": "People and environmental impact",
        "fields": [
          {
            "id": "people_affected",
            "label": "People affected",
            "type": "boolean",
            "required": true
          },
          {
            "id": "injury_details",
            "label": "Injury details",
            "type": "text",
            "required": false,
            "max": 2000
          },
          {
            "id": "environmental_impact",
            "label": "Environmental impact",
            "type": "boolean",
            "required": true
          },
          {
            "id": "environmental_details",
            "label": "Environmental details",
            "type": "text",
            "required": false,
            "max": 2000
          }
        ]
      },
      {
        "id": "controls",
        "title": "Immediate controls",
        "fields": [
          {
            "id": "immediate_controls",
            "label": "Immediate controls",
            "type": "array",
            "required": true
          },
          {
            "id": "emergency_services_contacted",
            "label": "Emergency services contacted",
            "type": "boolean",
            "required": true
          },
          {
            "id": "regulator_notification_required",
            "label": "Regulator notification required",
            "type": "boolean",
            "required": true
          }
        ]
      },
      {
        "id": "evidence",
        "title": "Evidence and witnesses",
        "fields": [
          {
            "id": "evidence_attachment_ids",
            "label": "Evidence attachments",
            "type": "array",
            "required": false
          },
          {
            "id": "witness_details",
            "label": "Witness details",
            "type": "array",
            "required": false
          }
        ]
      },
      {
        "id": "escalation",
        "title": "Escalation and follow-up",
        "fields": [
          {
            "id": "escalation_owner_id",
            "label": "Escalation owner",
            "type": "text",
            "required": true
          },
          {
            "id": "follow_up_required",
            "label": "Follow-up required",
            "type": "boolean",
            "required": true
          }
        ]
      },
      {
        "id": "approval_declaration",
        "title": "Approval and declaration",
        "fields": [
          {
            "id": "approval_id",
            "label": "Approval ID",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_by",
            "label": "Approved by",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_at",
            "label": "Approved at",
            "type": "text",
            "required": false
          },
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
