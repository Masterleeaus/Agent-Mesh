{
  "wizard": {
    "id": "supplier_receiving_discrepancy_v1",
    "version": "1.0.0",
    "name": "Supplier Receiving and Discrepancy",
    "capability": "inventory.receipts.record",
    "permissions": {
      "required_roles": [
        "staff",
        "supervisor",
        "manager",
        "admin"
      ]
    },
    "metadata": {
      "category": "inventory",
      "template_id": "supplier-receiving-discrepancy",
      "template_version": "1.0.0",
      "verticals": [
        "retail",
        "wholesale",
        "ecommerce",
        "construction"
      ],
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "high",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": [
        {
          "when": {
            "field": "discrepancy_found",
            "equals": true
          },
          "require_fields": [
            "discrepancy_summary",
            "evidence_attachment_ids",
            "resolution_owner_id",
            "resolution_due_at"
          ],
          "message_prefix": "Missing required supplier discrepancy action"
        }
      ]
    },
    "steps": [
      {
        "id": "receipt",
        "title": "Receipt",
        "fields": [
          {
            "id": "purchase_order_id",
            "label": "Purchase order ID",
            "type": "text",
            "required": true
          },
          {
            "id": "supplier_id",
            "label": "Supplier ID",
            "type": "text",
            "required": true
          },
          {
            "id": "received_at",
            "label": "Received at",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "items",
        "title": "Items and discrepancy",
        "fields": [
          {
            "id": "received_items",
            "label": "Received items",
            "type": "array",
            "required": true
          },
          {
            "id": "discrepancy_found",
            "label": "Discrepancy found",
            "type": "boolean",
            "required": true
          },
          {
            "id": "discrepancy_summary",
            "label": "Discrepancy summary",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "id": "evidence",
        "title": "Evidence and action",
        "fields": [
          {
            "id": "evidence_attachment_ids",
            "label": "Evidence attachments",
            "type": "array",
            "required": false
          },
          {
            "id": "resolution_owner_id",
            "label": "Resolution owner",
            "type": "text",
            "required": false
          },
          {
            "id": "resolution_due_at",
            "label": "Resolution due",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "id": "declaration",
        "title": "Review",
        "fields": [
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
