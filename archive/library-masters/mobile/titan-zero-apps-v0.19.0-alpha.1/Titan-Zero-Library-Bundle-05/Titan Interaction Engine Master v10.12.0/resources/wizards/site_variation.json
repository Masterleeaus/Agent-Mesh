{
  "wizard": {
    "id": "site_variation_v1",
    "version": "1.0.0",
    "name": "Site Variation",
    "capability": "crm.work_order.update",
    "permissions": {
      "required_roles": [
        "supervisor",
        "manager",
        "admin",
        "owner"
      ]
    },
    "metadata": {
      "category": "construction",
      "template_id": "site-variation",
      "template_version": "1.0.0",
      "verticals": [
        "trades",
        "construction"
      ],
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ],
      "surfaces": [
        "go",
        "command"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "high",
      "conflict_handling": "prompt_user"
    },
    "governance": {
      "required_context": [
        "company_id",
        "user_id",
        "device_id",
        "correlation_id"
      ],
      "completion_rules": [
        {
          "when": {
            "field": "cost_impact",
            "gt": 0
          },
          "require_fields": [
            "evidence_attachment_ids",
            "approval_id",
            "approved_by",
            "approved_at"
          ],
          "message_prefix": "Missing required site variation approval"
        }
      ]
    },
    "steps": [
      {
        "id": "site",
        "title": "Site and contract",
        "fields": [
          {
            "id": "project_id",
            "label": "Project ID",
            "type": "text",
            "required": true
          },
          {
            "id": "site_id",
            "label": "Site ID",
            "type": "text",
            "required": true
          },
          {
            "id": "contract_reference",
            "label": "Contract reference",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "variation",
        "title": "Variation",
        "fields": [
          {
            "id": "variation_summary",
            "label": "Variation summary",
            "type": "text",
            "required": true
          },
          {
            "id": "cost_impact",
            "label": "Cost impact",
            "type": "number",
            "required": true
          },
          {
            "id": "schedule_impact_days",
            "label": "Schedule impact days",
            "type": "number",
            "required": true
          }
        ]
      },
      {
        "id": "evidence",
        "title": "Evidence and approval",
        "fields": [
          {
            "id": "evidence_attachment_ids",
            "label": "Evidence attachments",
            "type": "array",
            "required": false
          },
          {
            "id": "approval_id",
            "label": "Approval ID",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_by",
            "label": "Approved by",
            "type": "text",
            "required": false
          },
          {
            "id": "approved_at",
            "label": "Approved at",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "id": "declaration",
        "title": "Review",
        "fields": [
          {
            "id": "declaration_accepted",
            "label": "Declaration accepted",
            "type": "boolean",
            "required": true
          }
        ]
      }
    ]
  }
}
