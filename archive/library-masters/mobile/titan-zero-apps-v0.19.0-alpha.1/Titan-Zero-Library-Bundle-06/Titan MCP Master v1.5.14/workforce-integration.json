  "provider_health": {
    "credential_checks_must_not_disclose_secrets": true,
    "availability_is_runtime_state_not_install_state": true,
    "health_states": [
      "healthy",
      "degraded",
      "unavailable",
      "blocked"
    ],
    "default": "unavailable",
    "deterministic_degradation_required": true
  },
  "work_item_contract": {
    "owner": "titan-ai-workforce",
    "extension_may_create_or_update_employee_identity": false,
    "extension_may_execute_without_work_item_authority": false,
    "required_context": [
      "company_id",
      "work_item_id",
      "capability_id",
      "provider_version"
    ],
    "command_context_additions": [
      "authority_decision_id",
      "idempotency_key",
      "correlation_id"
    ]
  },
  "runtime_discovery": {
    "contract": "titan.workforce.provider-discovery/v1",
    "discovery_owner": "titan-ai-workforce",
    "provider_key": "titan-mcp",
    "scope_key": "company_id",
    "registration_is_declarative": true,
    "install_state_never_implies_availability": true,
    "duplicate_provider_resolution": "blocked_until_pinned",
    "capability_catalog_source": "workforce-integration.json"
  },
  "runtime_health": {
    "contract": "titan.workforce.provider-health/v1",
    "default_state": "unavailable",
    "states": [
      "healthy",
      "degraded",
      "unavailable",
      "blocked"
    ],
    "probe_is_non_mutating": true,
    "probe_requires_company_scope": true,
    "credential_probe_redacts_secrets": true,
    "stale_after_seconds": 300,
    "failure_transition": "unavailable",
    "policy_denial_transition": "blocked",
    "degraded_transition": "degraded",
    "recovery_requires_fresh_probe": true
  },
  "capability_availability": {
    "contract": "titan.workforce.capability-availability/v1",
    "derived_from": [
      "provider_health",
      "policy",
      "authority",
      "dependency_health"
    ],
    "default": "unavailable",
    "fail_closed": true,
    "states": [
      "available",
      "degraded",
      "unavailable",
      "blocked",
      "policy_disabled"
    ],
    "authority_never_inferred_from_health": true,
    "health_never_inferred_from_install_state": true
  },
  "runtime_events": {
