{
  "schema": "titan.workforce.extension-integration.v1",
  "schema_version": "1.0",
  "provider": {
    "extension_key": "titan-maps-intelligence",
    "extension_name": "Titan Maps Intelligence",
    "extension_version": "2.0.9",
    "provenance_required": true,
    "provider_pin_required_for_execution": true
  },
  "ownership": {
    "workforce_identity_owner": "titan-ai-workforce",
    "extension_owns_employees": false,
    "extension_owns_roles": false,
    "extension_owns_hierarchy": false,
    "extension_owns_assignments": false,
    "extension_owns_work_items": false,
    "extension_domain_owner": "titan-maps-intelligence"
  },
  "tenancy": {
    "canonical_key": "company_id",
    "fail_closed": true
  },
  "availability": {
    "states": [
      "available",
      "degraded",
      "unavailable",
      "missing_provider",
      "blocked",
      "policy_disabled"
    ],
    "installed_does_not_imply_available": true,
    "available_does_not_imply_authorized": true,
    "provider_removal_preserves_workforce_identity": true
  },
  "capabilities": [
    "titan-maps-intelligence.search.businesses",
    "titan-maps-intelligence.search.read",
