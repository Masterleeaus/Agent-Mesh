        "authority_granted": {
          "const": false
        },
        "execution_permitted": {
          "const": false
        },
        "owns_domain_truth": {
          "const": false
        },
        "may_create_entities": {
          "const": false
        },
        "may_mutate_entities": {
          "const": false
        }
      }
