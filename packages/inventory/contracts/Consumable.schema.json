{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan.inventory.consumable.v1",
  "title": "Titan Inventory Consumable",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "consumable_id",
    "company_id",
    "name",
    "unit",
    "lifecycle_state",
    "provenance"
  ],
  "properties": {
    "consumable_id": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "catalog_product_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "lifecycle_state": {
      "enum": [
        "active",
        "restricted",
        "discontinued",
        "quarantined"
      ]
    },
    "hazard_class": {
      "type": [
        "string",
        "null"
      ]
    },
    "sds_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reorder_threshold": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "authority": {
      "type": "object",
      "properties": {
        "purchase_granted": {
          "const": false
        },
        "execution_granted": {
          "const": false
        }
      },
      "required": [
        "purchase_granted",
        "execution_granted"
      ]
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "marketplace_product_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "supplier": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "supplier_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "supplier_sku": {
          "type": [
            "string",
            "null"
          ]
        },
        "manufacturer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "compatibility": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "job_types": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surface_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "incompatibility_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "safety": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "safety_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "sds_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "sds_state": {
          "enum": [
            "SDS_REFERENCE_AVAILABLE",
            "SDS_REFERENCE_REQUIRED_NOT_PROVIDED",
            "SDS_REFERENCE_NOT_PROVIDED"
          ]
        },
        "hazard_class": {
          "type": [
            "string",
            "null"
          ]
        },
        "ppe_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "recorded_at",
        "idempotency_key"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        },
        "trace_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "correlation_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "tenant_id"
        ]
      }
    },
    {
      "not": {
        "required": [
          "tenant_company_id"
        ]
      }
    },
    {
      "not": {
        "required": [
          "business_id"
        ]
      }
    },
    {
      "not": {
        "required": [
          "account_id"
        ]
      }
    },
    {
      "not": {
        "required": [
          "workspace_id"
        ]
      }
    }
  ]
}
