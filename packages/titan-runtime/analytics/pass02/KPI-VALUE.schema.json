{
  "schema": "titan-zero-kpi-value/v1",
  "type": "object",
  "required": [
    "metric_id",
    "company_id",
    "window",
    "status",
    "provenance"
  ],
  "properties": {
    "metric_id": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "window": {
      "type": "object",
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "available",
        "missing",
        "partial",
        "stale",
        "invalid"
      ]
    },
    "value": {
      "type": [
        "number",
        "integer",
        "string",
        "null"
      ]
    },
    "unit": {
      "type": "string"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "source_ref"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_ref": {
            "type": "string"
          },
          "observed_at": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "missing_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "generated_at": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "rules": [
    "company_id is the sole tenant boundary",
    "status=missing requires value=null and non-empty missing_reason",
    "analytics never grants execution or business authority",
    "provenance source_id must exist in KPI-SOURCE-MAP.json"
  ]
}
