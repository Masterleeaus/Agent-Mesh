{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan-zero-module.schema.json",
  "title": "Titan Zero Module Manifest",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "kind"
  ],
  "additionalProperties": true,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "screenBlock": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "text",
            "metric",
            "list",
            "actions",
            "projection",
            "settings",
            "workers",
            "workflows"
          ]
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "projection": {
          "$ref": "#/$defs/id"
        },
        "panel": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "settingField": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        },
        "type": {
          "enum": [
            "text",
            "textarea",
            "number",
            "boolean",
            "select",
            "secret"
          ]
        },
        "description": {
          "type": "string"
        },
        "placeholder": {
          "type": "string"
        },
        "default": {},
        "options": {
          "type": "array"
        }
      }
    },
    "workflowStep": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "tool",
            "command",
            "projection",
            "set"
          ]
        },
        "module_id": {
          "$ref": "#/$defs/id"
        },
        "tool": {
          "$ref": "#/$defs/id"
        },
        "command": {
          "$ref": "#/$defs/id"
        },
        "projection": {
          "$ref": "#/$defs/id"
        },
        "key": {
          "type": "string"
        },
        "assign": {
          "type": "string"
        },
        "input": {},
        "value": {}
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+"
    },
    "kind": {
      "enum": [
        "packaged",
        "declarative"
      ]
    },
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "contributes": {
      "type": "object",
      "properties": {
        "capabilities": {
          "type": "array"
        },
        "intents": {
          "type": "array"
        },
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "mutates": {
                "type": "boolean"
              },
              "authority": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "links": {
          "type": "array"
        },
        "feed": {
          "type": "array"
        },
        "settings": {
          "type": "array"
        },
        "screens": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "blocks": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/screenBlock"
                }
              }
            }
          }
        },
        "workers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "instructions": {
                "type": "string"
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "workflow": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "channels": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "autonomy": {
                "type": "string"
              },
              "vertical": {
                "type": "string"
              },
              "department": {
                "type": "string"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "riskCeiling": {
                "type": "string"
              },
              "evidenceRequired": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "approvalRequiredFor": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "command": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "permissions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "inputSchema": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "outputSchema": {
                "type": [
                  "object",
                  "null"
                ]
              },
              "mutates": {
                "type": "boolean"
              },
              "authority": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "providers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "settingsPanel": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "projections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "source": {
                "enum": [
                  "settings",
                  "storage",
                  "static",
                  "runtime"
                ]
              },
              "key": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "value": {}
            }
          }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "steps": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "$ref": "#/$defs/workflowStep"
                }
              }
            }
          }
        },
        "settingsPanels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/settingField"
                }
              }
            }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "type": {
                "type": "string"
              },
              "workflow": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "command": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "verticals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "icon": {
                "type": "string"
              },
              "keywords": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "company_boundary": {
                "const": "company_id"
              },
              "source_of_truth": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "metadata": {
      "type": "object"
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modules": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "range": {
                "type": "string"
              },
              "optional": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "activation_confers_authority": {
          "const": false
        },
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "effect": {
                "type": "string"
              },
              "capability": {
                "type": "string"
              },
              "risk": {
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "critical"
                ]
              },
              "max_autonomy": {
                "enum": [
                  "suggest",
                  "assist",
                  "semi-auto",
                  "auto",
                  "trusted-auto",
                  "predictive"
                ]
              }
            }
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "compatibility": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "module_runtime": {
              "type": "string"
            },
            "titan_zero": {
              "type": "string"
            }
          }
        },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "activation_timeout_ms": {
              "type": "integer",
              "minimum": 250,
              "maximum": 60000
            },
            "deactivation_timeout_ms": {
              "type": "integer",
              "minimum": 250,
              "maximum": 60000
            }
          }
        },
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failure_threshold": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "failure_policy": {
              "enum": [
                "isolate",
                "disable"
              ]
            }
          }
        }
      }
    }
  }
}
