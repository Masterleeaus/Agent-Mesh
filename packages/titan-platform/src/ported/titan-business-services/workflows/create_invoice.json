{
  "wizard": {
    "id": "create_invoice_v1",
    "version": "1.0.0",
    "name": "Create Invoice",
    "capability": "crm.invoice.create",
    "permissions": {
      "required_roles": [
        "finance",
        "manager",
        "admin",
        "owner"
      ]
    },
    "metadata": {
      "category": "finance",
      "interfaces": [
        "chat",
        "mobile",
        "tablet",
        "desktop",
        "voice"
      ],
      "surfaces": [
        "command"
      ]
    },
    "offline": {
      "enabled": true,
      "sync_priority": "high",
      "conflict_handling": "prompt_user"
    },
    "steps": [
      {
        "id": "customer_job",
        "title": "Customer and job",
        "fields": [
          {
            "id": "customer_id",
            "label": "Customer",
            "type": "text",
            "required": true
          },
          {
            "id": "job_id",
            "label": "Job",
            "type": "text",
            "required": false
          }
        ]
      },
      {
        "id": "line_items",
        "title": "Invoice items",
        "fields": [
          {
            "id": "line_items",
            "label": "Line items",
            "type": "array",
            "required": true
          },
          {
            "id": "subtotal",
            "label": "Subtotal",
            "type": "number",
            "required": true,
            "min": 0
          },
          {
            "id": "tax",
            "label": "Tax",
            "type": "number",
            "required": true,
            "min": 0
          }
        ]
      },
      {
        "id": "payment",
        "title": "Payment details",
        "fields": [
          {
            "id": "total",
            "label": "Total",
            "type": "number",
            "required": true,
            "min": 0
          },
          {
            "id": "due_date",
            "label": "Due date",
            "type": "text",
            "required": true
          },
          {
            "id": "payment_method",
            "label": "Preferred payment method",
            "type": "select",
            "required": true,
            "options": [
              "cash",
              "payid",
              "bank_transfer",
              "credit_card"
            ]
          }
        ]
      },
      {
        "id": "delivery",
        "title": "Delivery",
        "fields": [
          {
            "id": "send_to_customer",
            "label": "Send to customer",
            "type": "boolean",
            "required": true
          },
          {
            "id": "notes",
            "label": "Invoice notes",
            "type": "text",
            "required": false,
            "max": 1000
          }
        ]
      }
    ]
  },
  "_titan_provenance": {
    "source_product": "Titan Interaction Engine",
    "source_version": "10.12.0",
    "source_path": "resources/wizards/create_invoice.json",
    "company_boundary": "company_id",
    "copied_without_domain_authority": true
  }
}
