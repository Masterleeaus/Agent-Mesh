{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan://contracts/AuthorityDecision/v1",
  "title": "AuthorityDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_decision_id",
    "company_id",
    "capability",
    "decision",
    "evaluated_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "authority_decision_id": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": [
        "allow",
        "deny",
        "require_approval",
        "constrain",
        "pause"
      ]
    },
    "autonomy_level": {
      "enum": [
        "suggest",
        "assist",
        "semi_auto",
        "auto",
        "trusted_auto",
        "predictive"
      ]
    },
    "risk": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
