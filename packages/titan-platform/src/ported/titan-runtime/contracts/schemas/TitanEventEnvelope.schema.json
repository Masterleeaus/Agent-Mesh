{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan://contracts/TitanEventEnvelope/v1",
  "title": "TitanEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "company_id",
    "occurred_at",
    "source",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "request_id": {
      "type": "string"
    },
    "idempotency_key": {
      "type": "string"
    },
    "actor_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    }
  }
}
