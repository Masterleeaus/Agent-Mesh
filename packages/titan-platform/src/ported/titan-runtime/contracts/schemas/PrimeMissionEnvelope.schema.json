{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan://contracts/PrimeMissionEnvelope/v1",
  "title": "PrimeMissionEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mission_id",
    "company_id",
    "objective",
    "state",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "mission_id": {
      "type": "string",
      "minLength": 1
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "operation_id": {
      "type": "string"
    },
    "objective": {
      "type": "object"
    },
    "state": {
      "enum": [
        "proposed",
        "active",
        "waiting",
        "blocked",
        "completed",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "checkpoint_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    }
  }
}
