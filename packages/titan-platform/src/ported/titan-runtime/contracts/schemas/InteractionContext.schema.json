{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan://contracts/InteractionContext/v1",
  "title": "InteractionContext",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "company_id",
    "surface",
    "authority_neutral"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "surface": {
      "enum": [
        "zero",
        "go",
        "hub"
      ]
    },
    "actor_id": {},
    "device_id": {},
    "operation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "conversation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "journey_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "wizard_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "locale": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "authority_neutral": {
      "const": true
    }
  }
}
