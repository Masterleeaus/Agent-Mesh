{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Titan Booking Proposal v1",
  "type": "object",
  "required": [
    "schema",
    "proposal_id",
    "intent_id",
    "state",
    "slot_ref",
    "expires_at",
    "company_id",
    "correlation_id",
    "idempotency_key",
    "grants_authority",
    "direct_mutation"
  ],
  "properties": {
    "schema": {
      "const": "titan.booking.proposal.v1"
    },
    "company_id": {
      "type": "string",
      "minLength": 2
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "worker_id": {
      "type": "string",
      "minLength": 1
    },
    "grants_authority": {
      "const": false
    },
    "direct_mutation": {
      "const": false
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "intent_id": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "proposed",
        "held",
        "accepted",
        "rejected",
        "expired",
        "conflict"
      ]
    },
    "slot_ref": {
      "type": "object"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "approval_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
