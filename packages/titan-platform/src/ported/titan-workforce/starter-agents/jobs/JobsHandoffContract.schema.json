{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"titan.zero.jobs.handoff.v1",
  "title":"Titan Zero Jobs Agent Handoff Contract",
  "type":"object",
  "required":["company_id","job_id","source","destination","authority_granted","execution_permitted"],
  "properties":{
    "company_id":{"type":"string","minLength":1},
    "job_id":{"type":"string","minLength":1},
    "source":{"const":"Jobs Agent"},
    "destination":{"type":"string","minLength":1},
    "completion_ref":{"type":["string","null"]},
    "evidence_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "authority_granted":{"const":false},
    "execution_permitted":{"const":false}
  },
  "additionalProperties":true
}
