{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Titan Workforce Human + Advanced Intelligence Unification",
  "type": "object",
  "required": [
    "schema",
    "company_id",
    "workers",
    "summary",
    "readiness",
    "policy",
    "grants_authority"
  ],
  "properties": {
    "schema": {
      "const": "titan.workforce.human-ai-unification.v1"
    },
    "company_id": {
      "type": "string",
      "minLength": 2
    },
    "workers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "worker_id",
          "company_id",
          "identity_kind",
          "identity_confers_authority",
          "grants_authority"
        ],
        "properties": {
          "identity_kind": {
            "enum": [
              "HUMAN",
              "ADVANCED_INTELLIGENCE",
              "UNKNOWN"
            ]
          },
          "identity_confers_authority": {
            "const": false
          },
          "grants_authority": {
            "const": false
          }
        }
      }
    },
    "summary": {
      "type": "object"
    },
    "readiness": {
      "type": "object"
    },
    "policy": {
      "type": "object"
    },
    "automatic_authority_change": {
      "const": false
    },
    "authority_granted": {
      "const": false
    },
    "execution_permitted": {
      "const": false
    },
    "grants_authority": {
      "const": false
    }
  }
}