{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan.workforce.customer-care.inventory.v1",
  "title": "Titan Customer Care Surface Inventory",
  "type": "object",
  "required": ["schema", "company_boundary", "authority_rule", "ownership", "existing_surfaces", "pass1_gaps"],
