    "schema": {"const": "titan.workforce.customer-care.inventory.v1"},
    "company_boundary": {"const": "company_id"},
    "authority_rule": {"const": "identity_does_not_grant_authority"},
    "ownership": {"type": "object"},
    "existing_surfaces": {"type": "object"},
    "pass1_gaps": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
