{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan.workforce.intelligence-routing.v1",
  "title": "Titan Workforce Intelligence Routing Policy",
  "type": "object",
  "required": [
    "schema",
    "company_id",
    "route_order",
    "providers",
    "policy",
    "readiness",
    "authority_granted",
    "execution_permitted",
    "grants_authority"
  ],
  "properties": {
    "schema": {
      "const": "titan.workforce.intelligence-routing.v1"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "route_order": {
      "type": "array",
      "items": {
        "enum": [
          "DETERMINISTIC",
          "DEVICE_LOCAL",
          "CUSTOMER_LOCAL",
          "BYO_API",
          "BYO_SERVICE",
          "TITAN_ENTITLED",
          "TITAN_METERED_ADDON"
        ]
      }
    },
    "free_tier": {
      "type": "boolean"
    },
    "providers": {
      "type": "array"
    },
    "policy": {
      "type": "object"
    },
    "readiness": {
      "type": "object"
    },
    "authority_granted": {
      "const": false
    },
    "execution_permitted": {
      "const": false
    },
    "grants_authority": {
      "const": false
    }
  },
  "additionalProperties": true
}