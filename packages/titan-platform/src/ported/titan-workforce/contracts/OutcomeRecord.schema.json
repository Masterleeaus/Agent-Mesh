{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "outcome_id",
    "company_id",
    "work_item_id",
    "receipt_refs",
    "verification_refs",
    "status"
  ],
  "properties": {
    "outcome_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "work_item_id": {
      "type": "string"
    },
    "receipt_refs": {
      "type": "array"
    },
    "verification_refs": {
      "type": "array"
    },
    "status": {
      "enum": [
        "pending_verification",
        "verified",
        "failed",
        "recovered"
      ]
    }
  }
}