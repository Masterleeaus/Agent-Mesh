{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan.workforce.improvement-proposals.v1",
  "title": "Titan Workforce Improvement Proposals",
  "type": "object",
  "required": [
    "schema",
    "company_id",
    "proposals",
    "summary",
    "learning_is_proposal_only",
    "no_silent_retraining",
    "authority_granted",
    "execution_permitted",
    "grants_authority"
  ],
  "properties": {
    "schema": {
      "const": "titan.workforce.improvement-proposals.v1"
    },
    "company_id": {
      "type": "string",
      "minLength": 2
    },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "proposal_id",
          "company_id",
          "kind",
          "proposal_only",
          "automatic_retraining",
          "automatic_production_change",
          "grants_authority"
        ]
      }
    },
    "summary": {
      "type": "object"
    },
    "learning_is_proposal_only": {
      "const": true
    },
    "no_silent_retraining": {
      "const": true
    },
    "authority_granted": {
      "const": false
    },
    "execution_permitted": {
      "const": false
    },
    "grants_authority": {
      "const": false
    }
  }
}