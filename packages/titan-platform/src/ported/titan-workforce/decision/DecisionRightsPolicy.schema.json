{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan.workforce.decision-rights.v1",
  "title": "Titan Workforce Decision Rights Policy",
  "type": "object",
  "required": [
    "schema",
    "company_id",
    "policy_id",
    "revision",
    "rules",
    "default_effect",
    "execution_right_exists",
    "grants_authority"
  ],
  "properties": {
    "schema": {
      "const": "titan.workforce.decision-rights.v1"
    },
    "company_id": {
      "type": "string",
      "minLength": 2
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "number",
      "minimum": 1
    },
    "default_effect": {
      "const": "deny"
    },
    "execution_right_exists": {
      "const": false
    },
    "grants_authority": {
      "const": false
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "rule_id",
          "decision_class",
          "right",
          "effect",
          "subject_type",
          "subject_id",
          "grants_authority"
        ],
        "properties": {
          "right": {
            "enum": [
              "RECOMMEND",
              "DECIDE",
              "APPROVE",
              "VETO",
              "ESCALATE",
              "OBSERVE"
            ]
          },
          "effect": {
            "enum": [
              "allow",
              "deny"
            ]
          },
          "subject_type": {
            "enum": [
              "worker",
              "role",
              "mission_team_member",
              "mission_team_supervisor",
              "mission_team_coordinator",
              "supervision_scope"
            ]
          },
          "grants_authority": {
            "const": false
          }
        }
      }
    }
  }
}