{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan.workforce.dispatch.release-certification.v1",
  "title": "Dispatch Release Certification",
  "type": "object",
  "required": ["schema","company_id","status","checks","ready_for_manager_merge","canonical_jobs_owned_elsewhere","canonical_scheduling_owned_elsewhere","direct_mutation","execution_permitted","identity_confers_authority","grants_authority"],
  "properties": {
    "schema": {"const": "titan.workforce.dispatch.release-certification.v1"},
    "company_id": {"type":"string","minLength":2},
    "status": {"enum":["CERTIFIED","REVIEW_REQUIRED","BLOCKED"]},
    "checks": {"type":"array","items":{"type":"object"}},
    "ready_for_manager_merge": {"type":"boolean"},
    "canonical_jobs_owned_elsewhere": {"const": true},
    "canonical_scheduling_owned_elsewhere": {"const": true},
    "direct_mutation": {"const": false},
    "execution_permitted": {"const": false},
    "identity_confers_authority": {"const": false},
    "grants_authority": {"const": false}
  },
  "additionalProperties": true
}
