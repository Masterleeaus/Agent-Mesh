{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "titan.authority.lease-control.v1",
  "type": "object",
  "required": [
    "company_id",
    "status",
    "max_authority_score",
    "identity_confers_authority",
    "control_can_raise_authority"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "company_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "active",
        "revoked"
      ]
    },
    "capability": {
      "type": [
        "string",
        "null"
      ]
    },
    "workflow": {
      "type": [
        "string",
        "null"
      ]
    },
    "context_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "max_authority_score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "revoked_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "control_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "identity_confers_authority": {
      "const": false
    },
    "control_can_raise_authority": {
      "const": false
    },
    "decision_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_provenance_seal": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
