# Titan Zero — transitional runtime VPS environment
# SQLite values below are for current runtime/compatibility storage only.
# They do not define operational business-domain persistence; #1051 Frappe/ERPNext
# owns mapped business materialization in the complete Business Node.
# The installer writes the canonical runtime environment to:
# /opt/titan-zero/shared/env/.env
APP_TAG=latest
APP_PORT=3000
APP_DOMAIN=
APP_BASE_URL=http://YOUR_SERVER_IP
APP_URL=http://YOUR_SERVER_IP
NO_TLS=0
SECURE_COOKIES=true

DATABASE_DIALECT=sqlite
DATABASE_URL=file:/app/data/titan-zero.db
SQLITE_PATH=/app/data/titan-zero.db

REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=256mb
REDIS_CONTAINER_MEMORY_LIMIT=384M
REDIS_CONTAINER_MEMORY_RESERVATION=128M

AUTH_SECRET=GENERATED_BY_INSTALLER
APP_ENCRYPTION_KEY=GENERATED_BY_INSTALLER
BOOKING_ACCOUNT_ID=00000000-0000-0000-0000-000000000000

# Optional AI provider credentials
ANTHROPIC_API_KEY=

# Optional email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional push
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com

WORKER_POLL_MS=30000
