{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"titan.scheduling.certification.v1",
  "title":"Titan Scheduling Certification",
  "type":"object",
  "required":["schema","company_id","claim_id","manager_baseline_merge","passes_completed","passes_complete","status","company_boundary","checks","failed_checks","authority_neutrality","claim_release_recommended","manager_convergence_required","direct_mutation","execution_permitted","authority_effect","authority_granted","grants_authority","identity_not_authority"],
  "properties":{
    "schema":{"const":"titan.scheduling.certification.v1"},
    "company_id":{"type":"string","minLength":1},
    "claim_id":{"type":"string","minLength":1},
    "manager_baseline_merge":{"type":"integer","minimum":1},
    "passes_completed":{"type":"array","minItems":12,"maxItems":12,"uniqueItems":true,"items":{"type":"integer","minimum":1,"maximum":12}},
    "passes_complete":{"const":true},
    "status":{"enum":["READY_FOR_MANAGER_MERGE","CERTIFICATION_FAILED"]},
    "company_boundary":{"const":"company_id_only"},
    "checks":{"type":"object"},
    "failed_checks":{"type":"array","items":{"type":"string"}},
    "authority_neutrality":{"const":true},
    "claim_release_recommended":{"type":"boolean"},
    "manager_convergence_required":{"const":true},
    "direct_mutation":{"const":false},
    "execution_permitted":{"const":false},
    "authority_effect":{"const":false},
    "authority_granted":{"const":false},
    "grants_authority":{"const":false},
    "identity_not_authority":{"const":true}
  },
  "additionalProperties":true
}
