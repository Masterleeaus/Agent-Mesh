{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"titan.workforce.starter.invoicing.exact-money.v1",
  "type":"object",
  "required":["schema","company_id","currency","calculation_engine_ref","exact_money_certified","arithmetic","line_items","totals","provenance","reconciliation","authority"],
  "properties":{
    "schema":{"const":"titan.workforce.starter.invoicing.exact-money.v1"},
    "company_id":{"type":"string","minLength":1},
    "currency":{"type":"string","pattern":"^[A-Z]{3}$"},
    "exact_money_certified":{"const":true},
    "calculation_engine_ref":{"const":"titan-invoicing-exact-money-v1"},
    "arithmetic":{"type":"object"},
    "line_items":{"type":"array","minItems":1},
    "totals":{"type":"object"},
    "provenance":{"type":"object"},
    "reconciliation":{"type":"object"},
    "authority":{"type":"object","properties":{"execution_permitted":{"const":false},"grants_authority":{"const":false}}}
  },
  "additionalProperties":true
}
