{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Titan Workforce Role/Worker Separation Projection",
  "type": "object",
  "required": ["schema", "company_id", "roles", "workers", "assignment_links", "counts", "invariants", "read_only", "grants_authority"],
  "properties": {
    "schema": {"const": "titan.workforce.role-worker-separation.v1"},
    "company_id": {"type": "string", "minLength": 2},
    "roles": {"type": "array"},
    "workers": {"type": "array"},
    "assignment_links": {"type": "array"},
    "counts": {"type": "object"},
    "diagnostics": {"type": "object"},
    "invariants": {"type": "object"},
    "read_only": {"const": true},
    "derived": {"const": true},
    "automatic_execution": {"const": false},
    "grants_authority": {"const": false}
  }
}
