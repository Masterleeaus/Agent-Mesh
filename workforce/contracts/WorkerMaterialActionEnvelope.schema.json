{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "action_id",
    "worker_actor_id",
    "company_id",
    "capability",
    "evidence",
    "evidence_state",
    "explanation",
    "expected_effect",
    "risk",
    "urgency",
    "authority_required",
    "idempotency_key",
    "trace_id",
    "correlation_id"
  ],
  "properties": {
    "action_id": {
      "type": "string"
    },
    "worker_actor_id": {
      "type": "string"
    },
    "company_id": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "minItems": 1
    },
    "evidence_state": {
      "type": "string"
    },
    "explanation": {
      "type": "object"
    },
    "expected_effect": {
      "type": "object"
    },
    "risk": {
      "type": "string"
    },
    "urgency": {
      "type": "string"
    },
    "authority_required": {
      "type": "object"
    },
    "approval_refs": {
      "type": "array"
    },
    "autonomy_decision_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string"
    },
    "execution_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "post_action_verification_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "trace_id": {
      "type": "string"
    },
    "correlation_id": {
      "type": "string"
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "proposed",
        "awaiting_data",
        "awaiting_approval",
        "ready",
        "executing",
        "recovery",
        "completed",
        "failed"
      ]
    }
  }
}